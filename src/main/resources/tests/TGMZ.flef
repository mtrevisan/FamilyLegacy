	source S2130 {
		title.value death Masutto Francesco 18100111 religious
		note {
			text """
Verbatim text: A[dí] 11 Gennaro 1810
Francesco figlio di Nicolo Masutto detto
Bardusco d'età d'anni 52 c[irc]a munito de
S[an]ti S[acramen]ti Confes[ione], ed estrema unzione
morí in D[omi]no in Uderzo ove e stato liberato
a cagione di contravenzione d'un poco di Tabaco
dalla giustizia, e posto in libertà passò all'eternità"""
			audit.creation.date 25 JUN 2022 12:20:27
		}
		repository.repository R26
		source {
			source S6814
