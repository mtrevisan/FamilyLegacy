	source S1566 {
		title.value deed 15271103 Pilizatus Michaeles + Trivisan Magdalena
		author nodaro Sermazia Giovanni Antonio
		note {
			text """
Verbatim text: 1527 Indict[ione] 15 . Die martis tercio mensis novembris i[n] domo ser melchioris infra=
sc[rip]ti : p[rese]ntib[us] mag[ist]ro Jacobo tosato, chabriele dicto biele de jopatis, et alexan=
dro q[uondam] danielis pilosi d[e] Scandolaria t[es]tib[us] r[ogati]s?
Ibiq[ue] cu[m] sit hodierna die c[on]tractu[m] fuerit legitimu[m] matrimoniu[m] tunc
p[er] v[er]ba d[e] p[rese]nti Int[er] honesta[m] juvene[m] d[ominam] magdalena[m] dicta lena
q[uondam] b[er]nardin trivisani ex una, et[iam] et Michaelem pilizatu[m] q[uondam] ser Cechi
de dicta villa p[ro]ut ex alt[er]a, ut ambo jugales co[n]fessi fueru[n]t
Nunc vero dictus michael sponsus confessus est habuisse et
recepisse i[n] p[rese]ntiar[um] a dicto ser melchiore eius patruo libras centu[m]
dece[m]oto soldos dece[m] par[vorum] i[n] tot bonis mobilib[us] estimatis : d[e] co[mmu]ne eor[um]
c[on]cordio de bonis pat[er]nis et mat[er]nis hoc modo libras triginta de
bonis mat[er]nis, residuu[m] vero de bonis pat[er]nis : de q[ui]bus sic ut s[upra]
habitis et recept[is] dictus michael vocavit se? sibiq[ue] fine[m]
fecit et cu[m] pactis et clausulis v[idelicet] librar[um] q[uin]q[ue] p[ro] in c[on]tro intra locu[m]
cu[m] obligat[ione] bonor[um] suor[um] i[n] casu dotis restituende et
Et eo die dicta magdalena de lice[n]tia fine fecit i[n] forma
cu[m] c[on]dict[ione] q[ue] si bona mat[er]na rep[er]iret[ur] plus aut minus p[ar]tes ip[s]e se in?ficere
Eo die, no[n] obstante co[n]fessione solut[ione] dicte dotis et dictus
melchior se c[on]stituit debitor dicti michaelis et magdalene
librar[um] vigintiunius p[ro] dotem par[te] sibi demder[um] libras decem
ad festu[m] nat[ivitate] d[omi]ni 1528, reliquu[m] ad aliud festu[m] nat[ivitate] 1529 :
p[ro] q[ui]b[us] obligavit et :-"""
			audit.creation.date 5 JUL 2026 15:09:09
		}
		repository.repository R2
		note {
			text busta 884
			audit.creation.date 2026-09-03T00:00:00Z
		}
		source {
			source S6036
			extract.document_part.document D3192
		}
		source {
			source S6037
			extract.document_part.document D3193
		}
		source {
			source S6038
			extract.document_part.document D3194
		}
		source {
			source S6039
			extract.document_part.document D3195
		}
		audit.creation.date 5 JUL 2026 15:09:09
	}

