	source S1585 {
		title.value death certificate Trevisan Angelo 19570202
		note {
			text """
Verbatim text: Sterbeurkunde
(Standesamt I in Berlin Nr. 1274/1957)
Der italienische militärinternierte Soldat
Angelo Trevisan
dessen Beruf und Wohnort unbekannt sind
ist am 7. September 1944 um 1 Uhr 10 Minuten
zu unbekannter Stunde
in Stablack/Ostpreussen in Kriegsgefangenen
lazarett
Der Verstorbene war geboren am 22. Januar 1923
in Treviso/Italien.
(Standesamt Treviso Nr. I/106/1923)

Berlin, den 2. Februar 1957
Der Standesbeamte
In Vertretung"""
			audit.creation.date 28 APR 2021 19:50:12
		}
		source {
			source S6069
			extract.document_part.document D3225
		}
		audit.creation.date 28 APR 2021 19:50:12
	}

