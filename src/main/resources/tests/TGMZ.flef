	source S1440 {
		title.value birth Trevisan Sante Luigi 19121023
		note {
			text """
Verbatim text: Il dichiarante mi ha denunciato la nascita suddetta, nella sua qualità di ufficiale a ciò delegato dalla direzione di questo Ospitale Civile ed Istituto Esposti, in cui la Michieletto Maria Anna ha partorito il bambino suddetto, ed in luogo del marito della medesima perché impedito.
Lo stesso dichiarante fu da me dispensato dal presentarmi il bambino perché gracile essendomi altrimenti accertato della verità della nascita."""
			audit.creation.date 22 MAR 2021 19:58:16
		}
		repository.repository R2
		source {
			source S5883
			extract.document_part.document D3039
		}
		audit.creation.date 22 MAR 2021 19:58:16
	}

