	}

	source S136 {
		title.value deed 16060304 Trivisanus Dominicus
		author nodaro Zucchello Innocenzio
		note {
			text """
Verbatim text: 1606 indi[ctio]n 4 die Sabbati 4 mensis martij Tar[viso] in Pal[ati]o
co[m]munis in Archivo p[rese]ntib[us] ex[imio] d[omino] Joanne Vulpino
cive Tar[visino], et R[everen]do D[omino] P[atre] Paulo S[ancti] Gioanni Rectore Ecc[lesiæ]
S[anctæ] Mariæ Saletti et[iam]

ser Dominicus Trivisanus de Scandolaria q[uondam] ser Andreæ omnio
? & et omnibus, et quib[usc]u[n]q[ue] suis causis, et litib[us]
p[resen]t[is] et fut[uri]s cum q[ui]b[us]cu[n]q[ue], et quacu[m]q[ue] ort[i]ta, et p[ro]terti?
cu? ser Ang[el]o Pavano de levacta Sylvellar[um] fecit, et
cons[titui]t suu[m] advocat[um], et p[ro]curat[ore]m ex[imiu]m D[ominum] Laur[entiu]m
Carno t[es]t[ibus] do? cive[m] Tar[visino] abse[n]t[em]? & ad comparendu[m]
ubi opus erit, et omnia necessaria faciendu[m] ?cus &
cu[m] facul[tatem] iurandi?, et subst[ituen]di & p[ro]? & cu?[m] s?o
st[arii]s? unius fr[umen]ti p[ro] anno ? p[ro]x[ime]? &&"""
			audit.creation.date 6 JUL 2026 16:16:50
		}
