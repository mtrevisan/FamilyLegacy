	place P5640 {
		name.value Accioli Vasconcellos, Santa Cruz, Espírito Santo, Brazil
		audit.creation.date 2026-09-03T00:00:00Z
	}

	event E10033 {
		type civil_marriage
		date.value.point.full_date {
			value 24 JUL 1904
			calendar gregorian
		}
		place.place P5640
		note {
			text """
Edmond Lempé Official do Registramento
Termo de Casamento
Aos vinte e quatro dias do mez de Julho do anno de mil novacentos e quatro as dez horas da manhã na casa das audicencias do Juiz Districtal do Accioli Vasconcellos Comarca de Santa Cruz Estado do Espirito Santo presentes o mesmo Juiz commigo Official do Registro interino e as testemunhas Paulo Josino dos Santos e Giovanni Fassina receberam se em matrimonio civil Giovanni Zaros filho legitimo de Zaros Antonio fallecido e Maria Milanesi com trinta e tres annos de idade, solteiro, lavrador natural da Italia e residente no Rio Pau Gigante com D.a [Dona] Carlotta Favarato filha letigima de Favaratto Domenico e Luigi Biscara com vinte e tres annos de idade solteira, profissao serviço domestico natural da Italia e residente no Rio Pau Gigante, as quaes no mesmo acto declararam que tinham tido antes do casamento as seguintes filhos Risieri com tres annos de idade, Fioravante com um anno de idade; que nao sao parentes entre si, nem tem outro impedimento legal que as inhiba de casar se um com outro. Em firmeza do que eu Edmond Lempé lavrei este acto que vae por todos assignado e a rogo da contrahente per nao saber ler nem escrever assigna Oscar Calmon.
Antonio Alves da Cunha
Giovanni Zaros
Oscar Calmon
Giovan Fassina idade 27 annos solteiro
lavorador residente no Rio Treviso
Accioli Vasconcelos
Paulo Josino dos Santos com 21 anno
solteiro rezidente no Pau Gigante"""
			audit.creation.date 2026-09-03T00:00:00Z
		}
		note {
			text """
Role: null
Role type: marriage"""
			audit.creation.date 2026-09-03T00:00:00Z
		}
		source.source S1306
		audit.creation.date 2026-09-03T00:00:00Z
	}

