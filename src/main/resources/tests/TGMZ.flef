	source S174 {
		title.value deed 16011117 Trivisanus Baptista
		author nodaro Istrana Francesco
		note {
			text """
Verbatim text: 1601 die 17 9bris
Ex[cellentissi]m[o] Officio Constitutus ser Baptista Trivisanus de Scandolaria
q[uondam] ser Antonij debitum confitendo sumpsit sente[n]tia[m]
volu[n]tariam dandi, et solvendi ser Antonio Boino
de Grio[n]no ducat[os] triginta tres à l[ibras] 6 s[oldos] 4 p[ro] du[cat]o
salvo? in tributatis et p[ro] totum mensem Junij
p[ro]x[im]i fut[uri] ducat[os] decem in rag[io]ne p[redic]ta; et ducatos
quindecim p[ro] totum diem S[ancti] Laurentij mensis
aug[us]ti p[ro]x[im]i fut[uri], ac residiuum p[ro] totu[m] mensem
7bris; quibus terminis transactis, et quoq[ue] ipsos
et no[n] facta solutione sup[radic]ta ex tunc, pro ut ex
tunc co[m]miset? tractu[m] t?em co[n]tra sup[radictu]m ser Baptistam,
vice? & renu[n]tians & omnibus feriis et suspen=
sionibus, ac suffragiis, quibus &
P[rese]ntibus d[ominos] Not[arij] p[re]sentis Officij &
Innoce[n]tius Zucchello not[ario] Fao[n]?, et massarius Arduini hoc ex[pens]a?
Sumpta ex l[ibr]o 355, fol[i]o 78 tergo, et in fidem
se? sol[ut]o die 26 9bris anni 1602"""
			audit.creation.date 6 JUL 2026 16:08:04
		}
		repository.repository R2
		note {
			text busta 1293, carta 1364
			audit.creation.date 2026-08-31T00:00:00Z
		}
		source {
			source S4248
			extract.document_part.document D1404
		}
		audit.creation.date 6 JUL 2026 16:08:04
	}

	source S171 {
		title.value deed 15870906 Trivisani Andrea
		author nodaro Sermacia Cypriani
		note {
			text """
Verbatim text: 1587 6/9: Indizione 15, Die dominica sexto m[e]n[si]s
Septembris Tar[visij] in domo habit[ationis] mei not[ar]ij
infras[crip]ti p[rese]ntibus ser Simone de Negrinis calli=
gariu[s] Tar[visij] in dicta contrata cum ser Melchioris et ser Joan=
ne da maniago habit[atoris] Tar[visij] cum ser nicolai testib[us]

Cum sit q[uod] de anno 1578 die 8 Junij
contractu[m] fuit in legitimu[m] Matrimonium per
verba tunc de p[rese]nti In[ter] d[omin]am Marietam filia[m]
q[uondam] ser Vianus Monegheti de morgano ex
una et ser Andream filium q[uondam] ser francisci
Trivisani de Scandolaria ex altera prout
dicti Jugales ad p[rese]ntiam sup[rascripto]r[um] testium,
et mei not[ar]ij infrascripti spo[n]te confessi fue=
runt et quia tunc temporis dicti contrac=
tus matrimonij nullum confectum fuit In[fra]s=
criptas dotis Inst[rumentu]m. Nunc vero dictus ser An=
dreas maritus sponte dixit et confessus
fuit habuisse et recepisse in dotem et dotis
no[m]i[n]e a p[re]facta d[omin]a marieta eius uxore
sive a dicto q[uondam] ser vianus eius socero pro ea
dante et solve[n]te in dotem et dotis no[m]i[n]e
libras ducentas septuaginta quinq[ue] soldos
duos par[vorum] in tot bonis mobilius tunc
\
tunc estimatis et bene appreciatis p[er] q[uondam] ser
Joanne[m] cargnu[m] de morganu et ser rochum
pelliza de Scandolaria estimatores tunc? electos a sup[rascrip]tis partibus ut constat Inve[n]tario
ipsius dotis sumpto ut dixerunt p[er] q[uondam] Rev[eren]du[m]
D[omi]nu[m] patrem Iosephu[m] de dicta villa de
morgano sub die 8 Junij 1578 à me not[ario] infrascripto viso relato et postea ipsis jugalibus restituto de bonis paternis tantu[m], Pro
quibus bonis suis pro qua dote sic ut sup[ra] habita recepta
dictus ser andreas maritus vocavit et dixit
sibi bene fuit solutu[m] et integre satisfact[um]
à dicta eius uxore p[rese]nti et r[ecipie]nti pro se et
suis hæredibus et ipsi uxori satisfactum
fuit in forma de Amplius dicta[m] dotem no[n]
petendo in parte nec in toto se datam
ipsam dictus ser Andreas maritus ex nunc
prout ex tunc vocavit et assecuravit sup[ra]
omnibus suis bonis mobilibus et Immo=
bilibus p[rese]ntibus et futuris, et in omnem
casu[m] dictis dotis restituendas dictus ser
andreas maritus p[er] se et suos hæredes,
redere et restituere p[ro]misit cui vel quibus de jure
spectabit et cum obligat[ione] o[mni]um bonor[um] suor[um]
p[rese]ntium et fut[urorum]"""
			audit.creation.date 6 JUL 2026 13:46:46
		}
		repository.repository R2
		note {
			text busta 852
			audit.creation.date 2026-08-31T00:00:00Z
		}
		source {
			source S4239
			extract.document_part.document D1395
		}
		source {
			source S4240
			extract.document_part.document D1396
		}
		audit.creation.date 6 JUL 2026 13:46:46
	}

	source S172 {
		title.value deed 15710410 Trivisani Pasqua
		author nodaro Sermazia Perozzo Cipriano
		note {
			text """
Verbatim text: X aprilis 1571: Indictione 14. die Martis decimo m[ens]is
aprilis Tar[vis]ij in off[ici]o sanitatis p[rese]ntibus ser
Josepho vince[n]tini q[uondam] ser bernardini d[e] busis
fabri in v?anico et ser Antonio nicolino
d[e] morgano q[uondam] blasijs
Ibiq[ue] D[omin]a pasqua dicta pasquina filia
q[uondam] ser hier[oni]mi Trivisani de Scandolaria et uxor
ser petri Joppati de Scandolaria de p[rese]ntia licentia
et consensu dicti eius mariti p[er] se et suos he=
redes dedit vendidit, cessit et renuntiavit
ser Dominico Trivisano eius germano q[uondam]
ser andrea d[e] dicta villa p[rese]nti r[ecipie]nti et ementi
pro se et suis hæredibus totam eius portio=
nem sibi spectantem, et p[er]tinentem campi
unius v[e]l c[ir]ca plus, et minus prout repe=
ritur ad comodu[m] et incomodum dicti emp=
toris terra arat[a] plantat[a], et vitigat[a] cum una
plantata in dictam venditricem p[er]ventam ex
hæreditate q[uondam] peregrini Trivisani ex q[uondam] mat=
theo Trivisano d[e] dicta villa germani p[re]dicte
venditricis et emptoris ab intestao defuncti
habito respectu ad alias portiones alior[um] suor[um]
\
consortu[m] de Trivisanis d[e] dicta villa posit[am]
in villa p[re]dicta de Scandolaria in loco dicto
al pontesello cui coheret à mane dictus emp=
tor, à meridie hæredes q[uondam] ser bernardi furla=
neti, à sero dictus emptor, et à mo[n]te
terra laborata p[er] bernardum Trivisanum
d[e] dicta villa salvis & p[re]cio ducator[um]
vigintiquinq[ue] à l[ibras] 6 s[oldos] 4 p[ro] ducato : quos
ad p[rese]ntiam sup[rascrip]tor[um] habuit & in auro, et mo=
netis de quibus finem fecit in forma
ad habendum et[iam] pacto stridandi &, et
de evictione in forma[m] sub obligat[ione]
et[iam]"""
			audit.creation.date 6 JUL 2026 12:07:46
		}
		repository.repository R2
		note {
			text busta 847, carta sciolta a un terzo circa
			audit.creation.date 2026-08-31T00:00:00Z
		}
		source {
			source S4241
			extract.document_part.document D1397
		}
