	event E6225 {
		type immigration
		date.value.point.full_date {
			value 29 SEP 1930
			calendar gregorian
		}
		place.place P31
		note {
			text """
Non c’era lavoro e Gallinaro Enrico Gaetano ha fatto una domanda per andare in Brasile ma non gli è andato bene. Aveva detto che c’era stato un [colpo di stato](https://it.qaz.wiki/wiki/Brazilian_Revolution_of_1930).
Tronchin Silvio (fratello di Tronchin Adele) l’ha fatto venire in Francia.
I primi anni lavorava in Savoia (per la ferrovia sembra) e poi si sono fermati in Lorraine."""
			audit.creation.date 2026-08-31T00:00:00Z
		}
		audit.creation.date 2026-08-31T00:00:00Z
	}

