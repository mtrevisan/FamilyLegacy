	source S2029 {
		title.value appraisal Trivisan Pollo 1538
		note {
			text """
Verbatim text: Pollo q[uondam] B[ar]th[olom]io Trivisan no[n] ha de p[ro]prio Tien affitto
In dicta villa d[e] scha[n]dolara da m[agistro] fran[cesc]o
spineda doct[or] - campi cinq[ue] v[e]l c[ir]ca ?
casa d[e] paia dove lui habita d[e] soi miora=
me[n]ti paga d[e] fitto for[men]to st[ara] cinq[ue] q[ue?]ta
una?
sorgo q[ue?]te do e meza
legne ca?a u[n] q[ue?]to u[n]
para do pollastri v[idelicet] -- 5 q[ue?]ti"""
			audit.creation.date 19 DEC 2021 13:17:44
		}
		repository.repository R2
		note {
			text Archivio Comunale, Estimi
			audit.creation.date 2026-08-31T00:00:00Z
		}
		source {
			source S6654
			extract.document_part.document D3810
		}
		audit.creation.date 19 DEC 2021 13:17:44
	}

