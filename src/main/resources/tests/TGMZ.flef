	source S1123 {
		title.value birth Chiaradia Maria 18840420
		note {
			text Verbatim text: La dichiarante venne da me dispensata dal presentarmi la suddetta bambina per la lontananza, mi ha denunciata la nascita suddetta per avere nelle preindicate sue qualità, prestati i susidi dell'arte sua alla Chiaradia nata Cordazzo Lucia al momento del parto, ed in luogo del marito, che non ha potuto denunciarla per trovarsi all'Estero.
			audit.creation.date 14 FEB 2021 20:19:48
		}
		repository.repository R29
