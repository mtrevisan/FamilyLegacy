	event E26179 {
		type burial
		date.value.point.full_date {
			value 3 JUL 1681
			calendar gregorian
		}
		place.place P2593
		source.source S2421
		note {
			text """
Nota, come son con li Fradesani? portato
ad' incontrar d[et]o Cadavero sino alla
morera di s[er] Bened[et]o Cavrolo, dove è la
Crosera di strada sú la Rosta, et ivi
hò ricevuto la consegna d[e]l d[et]o Cadavero
dal R[everen]do D[omino] Gio[vani] de Ros Curato della
Chiesa sud[et]a di S[an] Gio[vani] del Tempio et ciò
sia ad p[er]petuam rei memoriam et[iam]"""
			audit.creation.date 2026-08-31T00:00:00Z
		}
		audit.creation.date 2026-08-31T00:00:00Z
	}

