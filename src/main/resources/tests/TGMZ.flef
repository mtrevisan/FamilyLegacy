	source S148 {
		title.value deed 15481126 Benedicta + Trivisan Liberalis + Trivisan Benardinus
		author nodaro Novello Giuliano
		note {
			text """
Verbatim text: emperatio
B[ernardi]ni Trivisani
d[e] Scandolaria

1548 ind[ictione] 6a, die lunæ vigesimosexto no[vem]bris tar[visij]
Ante feriatam carceris parochiæ s[ancti] vitti præ=
sentibus ser dominico pizaguera hospite in contrata
vacis? ine? et petro benzono q[uondam] ser Joannis et m[agistr]o Lau=
rentio figiolo q[uondam] nicolai salicati habitantibus in
tar[vis]o testibus et alijs

anno 1546 die decimo nono no[vem]bris d[omina] benedicta
v[idua] franc[isc]i Trevisani d[e] Scandolaria, et liberalis
ac b[er]nardinus eius filij tacite vendiderunt
ser hier[onim]o q[uondam] ant[on]ij piva d[e] s[ancti] salvatore custodi car=
cerum Tar[visij]. campum unum terræ ar[ativae]
tantum ad perticam et mensuram tar[visinam] situm
in villa Scandolariæ in contrata alla peza granda
coh[er]et ab una Andreas trivisanus ab alia h[e]redes
menegi Trivisani. ab alia h[e]redes ser bernardi
fulatoris et ab alia michael q[uondam] franc[isc]i peliciis
sal[vis] et[iam]? p[re]cio librarum centum s[olidorum] habitas ?
pacto redimendi quandacumq[ue] in Tar[visi]no annor[um]
q[ui]nq[ue] eodem p[re]tio et exp[ens]is instrumenti ut
latius in instr[umen]to scripto p[er] me no[m]i[n]e su die p[re]d[i]c[t]a
Hunc aut[em] dictus ser hier[onimu]s p[er] se et h[e]redes in?=
tate? d[ic]ti pacti dedit et retrovendidit dictu[m]
campum terræ dicto bernardino filio d[ic]ti
q[uondam] franc[isc]i trivisani p[rese]nti r[ecipien]ti sip[ulan]ti et re=
cuperanti no[m]i[n]e suo et d[omina] benedictæ matris
et liberalis fr[atr]is ? eis et heredib[us] repo=
nens dictum b[er]nardinu[m] dictis no[m]i[n]ib[us] p[re]sentem
et acceptantem i[n] omne locum et ius, statum
et esse in q[ui]b[us] erant ipsi venditores ante
instrumentum vendit[ionis]; et hoc q[ui]a habuit
et recepit dictus ser hier[onimu]s à ser ant[oni]o cetero
\
q[uodam] ser b[ernardi]ni d[e] cervaria ibi p[rese]nte dante et sol=
vente no[m]i[n]e d[ic]ti b[ernardi]ni trivisani libras
centum s[oldos] in auro et monetis ad p[re]sent[iam]
testium et mei not[arij] p[ro] quibus sic habitis
vocavit satisfactum et finem fecit i[n] f[o]r[m]a
d[e] p[re]cio p[re]dicto et q[ui]a satisfacientis p[ro]misit
idem b[er]nardinus mihi no[m]i[n]e exp[ens]as instr[umen]ti
nu[n]dum haberi nec satisfacti. ad habendu[m]
d[e] coetero i[n] f[orm]a. p[ro]mittens quo ad se et pro
facto suo ta[m] idem ser hier[onimu]s d[e] evict[ione] et
legit[ima] defensione in forma et huius mo=
di retrovendit[ionis] et o[mn]ia et singula in p[rese]nti
instr[umen]to contenta firma et rata promisit
habiturus? sub obligatione bonor[um] suorum
omnium presentium et futurorum.

et habui? p[ro] instr[umen]to p[re]cedenti empt[or] ser hier[onim]i l[ibras] 2 s[oldos] 16 a d[ic]to b[ernardinu]m"""
			audit.creation.date 5 JUL 2026 16:42:37
		}
		repository.repository R2
		note {
			text busta 703, carta 162r
			audit.creation.date 2026-09-03T00:00:00Z
		}
		source {
			source S4188
			extract.document_part.document D1344
		}
		source {
			source S4189
			extract.document_part.document D1345
		}
		audit.creation.date 5 JUL 2026 16:42:37
	}

	source S149 {
		title.value deed 15510126 Trevisani Bernardo
		author nodaro Padova Livio
		note {
			text """
Verbatim text: Eo die et loco p[rese]ntibus ser vince[n]tio de
castrofrancho q[uondam] ser lazari not[arium] Tar[visinum] : et
ser Jo[ann]e grigoleto q[uondam] ser gregorij habit[atoris]
in villa de begulino t[es]tib[us] vocat[is] &
Ibiq[ue] nob[il] vir d[omino] Scipio d[e] reinal=
dis Nob[il] Tar[visino] p[er] se et hæredes
dedit et ve[n]dedit : una[m] equa[m] rubra[m]
cu[m] stella in fro[n]t[e] ætatis p[ro]ut
reperitur : Bernardo q[uondam] franc[isc]i
trevisani de Scandolaria habit[antis] in
dicta villa p[rese]nt[is] p[ro] se et hæredibus
eme[n]ti et stip[ulan]ti et hoc p[re]cio et merca[to]
duca[torum] otto a l[ibras] 6 s[oldos] 4 pro duca[to]
quos denarios et q[uo]d p[re]ciu[m] dare et
solvere promisit ad o[mn]e vendes rogat[is]
\
hoc exp[re]sso pacto declarato q[uo] dura[n]te
mora exbursationis et solutionis
dicti p[re]cij q[uo] dictus empt[or] iure affita=
tionis teneatur et sic promisit
cu[m] obligat[ione] omnia[m] suoru[m] bonorum
p[rese]nt[ium] et fut[urorum] dare et solvere d[e] affictu
ipse d[omino] vendit[or] vel hæredib[us] quartas
tres frume[n]ti boni, mu[n]di, sicci, et bene
cribelati condut[is] Tar[visij] sup[ra] hortum
dicti d[omino] vendit[or] incepiendo solvere
ad festu[m] S[ancti] petri de iunio prox[ime] ve[nturis]
reservato quoq[ue] dominio
ex parte dicti d[omino] vendit[or] dictæ
equæ sive alterius eius loco usq[ue]
ad integra[m] solutione[m] dicti p[re]cij
dice[n]s et assere[n]s empt[or] ipso equa[m]
ipsa[m] penes se habere o[mn]i recept[ione]
equa no[n] habere speiq[ue] fut[urae] dat[ion]is
ac promisit solvere aliu[m] et o[mn]ia
sup[radic]ta habere firma rata &
decla[ran]do ipsa[m] equa[m] fuisse et esse
\
venditam pro ut reperitur cu[m]
dictus d[omino] vendit[or] no[n] nece[n]dit? alit[er]
subiacere pro aliq[u]o morbo ta[m] evide[n]t[e]
q[uam] occulto"""
			audit.creation.date 5 JUL 2026 16:54:28
		}
		repository.repository R2
		note {
			text busta 562, carta 188
			audit.creation.date 2026-09-03T00:00:00Z
		}
