			extract.document_part.document D3634
		}
		audit.creation.date 6 JUL 2026 10:33:12
	}

	source S1931 {
		title.value deed 15280515 Trivisanus Dominicus
		author nodaro Sermazia Giovanni Antonio
		note {
			text """
Verbatim text: In Christi no[m]i[n]e ame[n] : Anno a nat[ivitate] eiusde[m] 1528 . Indict[ione] p[rima] Die veneris
15 men[s]is madij i[n] domo habit[ationis] ser Angeli Jopati de Scandolaria
p[rese]ntib[us] ip[s]o ser Angelo Jopato et philipo bulifato q[uondam] ser Joa[n]nis : ambobus de
dicta villa et Jacobo q[uondam] liberalis Jopati d[e] Zerolo t[es]tib[us] rogat[is] et

Ibiq[ue] D[o]m[ini]cus dicto menego et Trivisanus fr[atr]es et filij q[uondam] ser antonij
trivisani de Scandolaria Ambo Simul et i[n]solidu[m] i[n] toto et i[n] p[ar]te
ad libitu[m] infrasc[rip]tor[um] venditor[um] obligati : Titulo et no[m]i[n]e vendit[ionis]
cessionis et traditionis p[er] se et suos he[re]des ad p[ro]priu[m] iure p[ro]prij : et
i[n]p[er]petuu[m] fecerunt datam venditione[m] : tradit[ionem] : et cessionem Mel=
chiori trivisano eor[um] fratri et angelo eius filio p[rese]ntib[us] r[ecipie]ntib[us] et eme[n]=
tib[us] p[ro] se et eor[um] heredib[us] de suis iurib[us] una pecia te[r]re campor[um] duor[um]
cum dimidio vel c[ir]ca tere arat[ivae] cu[m] plantatis po[s]it[am] et jacent[em]
i[n] dicta villa d[e] Scandolaria i[n] luogo dicto al ponteselo infra hos c[on]fi=
nes a mane illi de jopatis de Scandolaria
a meridie ide[m] de jopatis p[ar]ti[m] et p[ar]ti[m] dicti empt[ori] a sero dicti empt[ori]
et a mo[n]te dicti de jopatis p[ar]ti[m] et p[ar]ti[m] ser b[er]nardus folator panor[um]
i[n] Tar[visi]o salvis et[iam] quat[uor] terrar[um] declarat[ur] t[a]m[en] q[uod] ser Toninus Cinel=
lus q[uondam] ser lau[ren]tij de morgano habet ius i[n] campis duob[us] librar[um] ducator[um] par[vorum]
v[idelicet] libras centu[m] p[ro] campo ?te? duor[um] Infr[ascrip]tor[um] venditionis quor[um] unius manu
q[uondam] ser franc[isc]i rubegani not[ar]ij et civis tar[visi]ni et alt[era] manu q[uondam] ser
nicolai de turisellis not[ar]ij et civis tar[visi]ni ut ip[s]i c[on]trahentes asserverunt
factor[um] p[er] dictu[m] q[uondam] ser antoniu[m] : eide[m] q[uondam] ser laurentio cinello : cu[m] pacto
ret[r]oemendi eode[m] p[re]cio : et etia[m] ser Joa[n]nes bellansa civis tar[visin]us eor[um]
patronus h[ab]et ius i[n] dimidio campo virtute unius Instr[ument]i asserverationis
sibi facte p[er] infrasc[rip]tu[m] trivisanu[m] p[ro] duc[atorum] d[e]ce[m] p[ro] residuis affictuu[m] i[n]
cursor[um] no[n] solutor[um] : et hoc etia[m] cu[m] pacto de redime[n]do dictu[m] campu[m]
dimidiu[m] te[r]re : et hoc no[m]i[n]atim p[re]cio et mercato finito et c[on]cluso du=
cator[um] quindeci[m] cu[m] dimidio aur[i] i[n] racione l[ibras] 6 s[oldos] 4 p[ro] ducato, ultra p[re]cia
p[re]dicta alias exbursata p[er] dicta pecia te[r]rae p[er] dictu[m] q[uondam] ser laure[n]tiu[m] Ci=
nellu[m] Et ducatos dece[m] aur[i] i[n] ca? ypothecatis p[ro] affictib[us] i[n] cursis
et no[n] solutis : ut s[upra] eide[m] ser Joa[n]ni bellansa : de q[ui]bus ducatis qui[n]deci[m] cu[m] dimi=
dio dicti emptores i[n] p[rese]ntia[m] dictor[um] testiu[m] et mei not[ar]ij Infrasc[rip]ti dederu[n]t"""
			audit.creation.date 5 JUL 2026 16:10:02
		}
