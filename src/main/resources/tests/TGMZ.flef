	source S2601 {
		title.value Masutti Otello 19420831
		note {
			text """
Verbatim text: ROMA
Con riferimento alla nota a margine, comunicasi che
non si è in grado di esprimere alcun parere circa il
rilascio del passaporto in favore del nominato in og=
getto, in quanto chè il medesimo è nato all'estero, e non
ha mai risieduto a Prata di Pordenone. Il di lui padre
nel 1921 in quel comune si è reso responsabile di omi=
cidio di carattere politico in persona del fascista
Salvato Arturo. E' un fuoriuscito. Il Masutti Otello non ha
precedenti di sorta agli atti di ufficio."""
			audit.creation.date 26 MAR 2023 12:30:06
		}
		source {
			source S7323
			extract.document_part.document D4479
		}
		audit.creation.date 26 MAR 2023 12:30:06
	}

