	source S1962 {
		title.value municipal Trevisan Valentino vendita al minuto 18610915
		note {
			text """
Verbatim text: N° 226	IV	N° 226

Valentino Trevisan d[ett]o Dorato
domanda esser posto nel Ruolo
Arti e Commercio p[er] vendita
Acquavite e Pane al minuto

Al Villico Trevisan d[ett]o Dorato
Canizzano

Ritenuto che con la formazione
dei nuovi Ruoli Arti e Commercio
voi vi sarete incluso e pagherete la
tassa competente al 3° grado - Frattanto
vi si accorda la facoltà di poter vendere
acquavite e Pane al minuto senza
fermativa; sottoponendovi a tutte le
Leggi di Polizia, e che l'esercizio sia
chiuso ogni giorno alle ore 10 pome[ri]d[ian]e
e nei giorni festivi durante le sacre
funzioni ecclesiastiche.
Dalla Dep[utazione] C[omunale] li 15 9[mbre] [18]61"""
			audit.creation.date 2 OCT 2021 10:33:32
		}
		repository.repository R2
		note {
			text Archivio Comunale di Canizzano
			audit.creation.date 2026-09-03T00:00:00Z
		}
		source {
			source S6551
			extract.document_part.document D3707
		}
		audit.creation.date 2 OCT 2021 10:33:32
	}

