	event E9868 {
		type birth
		date.value.point.full_date {
			value 7 SEP 1894
			calendar gregorian
		}
		place.place P2097
		source {
			source S1173
			location pag 176v, #701
		}
		note {
			text ore 14:30+00:24
			audit.creation.date 2026-08-31T00:00:00Z
		}
		note {
			text """
Op heden den achtten September achttienhonderd vier en negentig, verscheen voor ons Ambtenaar van den Burgerlijken Stand der gemeente Zwolle, Charles Hofmann oud zeven en veentig jaren, van beroep (zonder) wonende te Zwolle, in tegenwoordighheid van twee getuigen, de eerste genaamd: Herm Fan Baarstag, oud zesenveentig jaren, van beroep gemeentebode, wonende te Zwolle, en de tweede: Pieter Raesink, oud vijfenveentig jaren, van beroep gemeentebode, wonende te Zwolle, die ons heeft aangegeven, dat zijne echtgenoote Johanna Hendrika Cuper, zonder beroep, wonende te Zwolle op den zevenden dezer maand des woormiddags ten halfture ure, te Zwolle, in een huis, staande in de Praubstraat is bevallen van een kind van het manne lijk geslacht, aan hetwelk de voornaamis gegeven van Teunis.
Van welke aangifte wij deze akte hebben opgemaakt, die, na voorlezing, is geteekend door ons man comparant en de getuigen."""
			audit.creation.date 2026-08-31T00:00:00Z
		}
		audit.creation.date 2026-08-31T00:00:00Z
	}

