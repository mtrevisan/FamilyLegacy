HEADER :=
n HEADER    {1:1}
  +1 PROTOCOL <PROTOCOL_NAME>    {1:1}
    +2 NAME <NAME_OF_PROTOCOL>    {1:1}	/* The name of the protocol. */
    +2 VERSION <VERSION_NUMBER>    {1:1}	/* The version of the protocol, following Semantic Versioning (https://semver.org/). It is defined and changed by the creators of the product. */
  +1 SOURCE <APPROVED_SYSTEM_ID>    {1:1}	/* A system identification name. Must be unique across products. Spaces must be substituted with underscores. */
    +2 NAME <NAME_OF_PRODUCT>    {0:1}	/* The human-readable name of the software product that produced this file. */
    +2 VERSION <VERSION_NUMBER>    {0:1}	/* The version of the software product, following Semantic Versioning (https://semver.org/). It is defined and changed by the creators of the product. */
    +2 CORPORATE <NAME_OF_BUSINESS>    {0:1}	/* The name of the organization or person that produced or commissioned the product. */
  +1 DATE <DATE>    {1:1}	/* A date object giving the date this source was created (as defined by ISO 8601: https://en.wikipedia.org/wiki/ISO_8601). */
  +1 COPYRIGHT <COPYRIGHT_SOURCE_DATA>    {0:1}	/* A copyright statement needed to protect the copyrights of the submitter of this file. */
  +1 SUBMITTER    {1:1}	/* The person or entity submitting this file. */
    +2 NAME <SUBMITTER_NAME>    {1:1}	/* The name of the submitter formatted for display and address generation. */
    +2 <<CONTACT_STRUCTURE>>    {0:M}	/* Contact information for the submitter (phone, email, web, etc.). */
    +2 NOTE <SUBMITTER_NOTE_STRUCTURE>    {0:M}	/* Any notes related to the submitter. */
  +1 SCOPE <CONTENT_DESCRIPTION>    {0:1}	/* A brief description of the file's genealogical scope (e.g., "Ancestors of John Doe"). */


RECORD :=
[
n <<INDIVIDUAL_RECORD>>    {1:1}
|
n <<GROUP_RECORD>>    {1:1}
|
n <<EVENT_RECORD>>    {1:1}
|
n <<INDIVIDUAL_ATTRIBUTE_RECORD>>    {1:1}
|
n <<EVENT_PARTICIPATION_RECORD>>    {1:1}
|
n <<GROUP_ATTRIBUTE_RECORD>>    {1:1}
|
n <<RELATIONSHIP_RECORD>>    {1:1}
|
n <<PLACE_RECORD>>    {1:1}
|
n <<PLACE_RELATIONSHIP_RECORD>>    {1:1}
|
n <<NOTE_RECORD>>    {1:1}
|
n <<REPOSITORY_RECORD>>    {1:1}
|
n <<CULTURAL_NORM_RECORD>>    {1:1}
|
n <<SOURCE_RECORD>>    {1:1}
|
n <<HISTORIC_EVENT_RECORD>>    {1:1}
|
n <<IDENTITY_HYPOTHESIS_RECORD>>    {1:1}
|
n <<RESEARCH_STATUS_RECORD>>    {1:1}
|
n <<RESEARCH_LOG_RECORD>>    {1:1}
]


END_OF_FILE :=
n EOF    {1:1}


INDIVIDUAL_RECORD :=	/* A representation of a historical individual together with the facts, events, relationships, and evidence believed to apply to that individual. */
n @<XREF:INDIVIDUAL>@ INDIVIDUAL    {1:1}
  +1 <<PERSONAL_NAME_STRUCTURE>>    {0:M}	/* One or more names associated with this individual (birth name, married name, alias, etc.). */
  +1 SEX <SEX_VALUE>    {0:1}	/* Biological sex as recorded or inferred (MALE, FEMALE, or UNKNOWN). */
  +1 CULTURAL_NORM @<XREF:CULTURAL_NORM>@    {0:M}	/* Cultural norms that apply to this individual (e.g., naming conventions, age of majority). */
..  +1 NOTE @<XREF:NOTE>@    {0:M}	/* Free-text notes about this individual. */
  +1 <<SOURCE_CITATION>>    {0:M}	/* Source citations supporting facts about this individual. */
  +1 PREFERRED_IMAGE <RESOURCE_URI>    {0:1}	/* Resource URI (following RFC 3986 specifications) pointing to a preferred image of this individual. */
    +2 CROP <CROP_COORDINATES>    {0:1}	/* Top-left and bottom-right coordinates of the enclosing box inside an image. Required when citing a specific part of an image-based source. */
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}	/* Privacy and distribution restrictions for this individual. */
  +1 <<CONCLUSION_STRUCTURE>>    {0:M}	/* Formal conclusions about this individual (e.g., resolution of birth date, death, or identity). */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


PERSONAL_NAME_STRUCTURE :=	/* A structured personal name composed of one or more name parts. This structure is intended to support naming systems from all cultures, including given names, family names, patronymics, matronymics, clan names, lineage names, titles, and other naming components. The order of PART elements is significant and should reflect the historical or culturally appropriate representation of the name. */
n NAME    {1:1}
  +1 TYPE <NAME_TYPE>    {0:1}	/* Classification of the name. For example: 'official'/'religious' (name given on a civil/religious birth certificate), 'aka' (an unofficial pseudonym, also known as, alias, etc), 'nickname' (a familiar name), 'immigrant' (name assumed at the time of immigration), 'legal' (legally changed name), 'married' (name assumed at marriage), 'adoption' (name assumed upon adoption), 'fostering' (name assumed upon fostering), etc -- https://github.com/FamilySearch/gedcomx/blob/master/specifications/name-part-qualifiers-specification.md. */
  +1 PART    {1:M}	/* The order of PART elements is significant and reflects the culturally appropriate representation of the full name (e.g., 'given' then 'family' for Western names, 'family' then 'given' for East Asian names). */
    +2 TYPE <NAME_PART_TYPE>    {1:1}	/* The role of this name component. Known values include: 'given', 'family', 'patronymic', 'matronymic', 'clan', 'lineage', 'tribal', 'title', 'nickname', 'family nickname', 'generation', 'suffix', 'prefix', or other culturally specific classifications. */
    +2 VALUE <TEXT>    {1:1}	/* The textual value of this individual name component. */
..    +2 <<TEXT_VALUE_VARIANT>>    {0:M}	/* Alternative phonetic, transliterated, or transcribed representations of this name component. */
  +1 CULTURAL_NORM @<XREF:CULTURAL_NORM>@    {0:M}
..  +1 NOTE @<XREF:NOTE>@    {0:M}
  +1 <<SOURCE_CITATION>>    {0:M}

NAME_STRUCTURE :=	/* A generic naming structure used for places, organizations, repositories, groups, and other non-person entities. Unlike PERSONAL_NAME_STRUCTURE, this structure does not decompose the name into culturally-specific components. */
n NAME    {1:1}
  +1 <<TEXT_VALUE>>    {1:1}	/* The textual value of the name, with optional locale and validity dates. */
  +1 TYPE <NAME_TYPE>    {0:1}	/* Geographical/Institutional: 'official', 'colonial', 'indigenous'. */

TEXT_VALUE :=	/* A textual value representing a name, address, title, label, or other historically relevant text associated with an entity. Multiple TEXT_VALUE structures may be recorded when the same entity is known by different historical, linguistic, official, or customary names. */
n VALUE <TEXT>    {1:1}	/* The primary textual value. */
..  +1 <<TEXT_VALUE_VARIANT>>    {0:M}	/* Alternative phonetic, transliterated, or transcribed representations. */
..  +1 LOCALE <LOCALE_CODE>    {0:1}	/* The locale identifier for this text (as defined by IETF BCP 47: https://tools.ietf.org/html/bcp47). */
  +1 VALID_FROM    {0:1}	/* The date from which this name was known to be in use. */
    +2 <<DATE_STRUCTURE>>    {1:1}
  +1 VALID_TO    {0:1}	/* The date until which this name was known to be in use. */
    +2 <<DATE_STRUCTURE>>    {1:1}
..  +1 NOTE @<XREF:NOTE>@    {0:M}
..  +1 <<SOURCE_CITATION>>    {0:M}

..TEXT_VALUE_VARIANT :=	/* Alternative written, phonetic, transliterated, or transcribed representations of the same textual value. These representations do not constitute separate names; they are alternate renderings of the same name. */
..[
..n PHONETIC <PHONETIC_SYSTEM>    {1:1}	/* Usually IPA, but other systems can be used (e.g., canIPA). */
..  +1 VALUE <PHONETIC_NAME_PIECE>    {1:1}	/* Phonetic/phonematic component. */
..|
..n TRANSCRIPTION <TRANSCRIPTION_SYSTEM>    {1:1}	/* Indicates the system used to transcribe the text to the romanized variation (e.g., 'romaji', 'pinyin', 'wadegiles', ...). */
..  +1 TYPE <TRANSCRIPTION_TYPE>    {0:1}	/* Type of transcription, usually 'romanized' (but it can be 'anglicized', 'cyrillized', 'francized', 'gairaigized', 'latinized', etc). */
..  +1 VALUE <TRANSCRIPTION_NAME_PIECE>    {1:1}	/* Transcribed component. */
..]


EVENT_RECORD :=	/* Represents the occurrence of a historical action, ceremony, condition, transaction, legal process, or other happening. An EVENT describes what happened. Persistent associations resulting from an event SHOULD be represented separately using RELATIONSHIP records. */
n @<XREF:EVENT>@ EVENT    {1:1}
  +1 TYPE [ BIRTH | DEATH | ADOPTION | GRADUATION | IMMIGRATION | NATURALIZATION | BANKRUPTCY | GUARDIANSHIP | CORONER_REPORT | CREMATION | BURIAL | EDUCATION | RETIREMENT | MILITARY_INDUCTION | MILITARY_MUSTER_ROLL | MILITARY_SERVICE | MILITARY_AWARD | MILITARY_RELEASE | MILITARY_DISCHARGE | MILITARY_RESIGNATION | MILITARY_RETIREMENT | PRISON | PARDON | JURY_DUTY | ILLNESS | HOSPITALIZATION | MEDICAL_PROCEDURE | HONOR | DEPORTATION | INTERNMENT | LIBERATION | EMANCIPATION | RELOCATION | EMIGRATION | CENSUS | DEED | ESCROW | CHANCERY | WILL | PROBATE | ENGAGEMENT | MARRIAGE_BANN | MARRIAGE_CONTRACT | MARRIAGE_LICENCE | MARRIAGE_SETTLEMENT | MARRIAGE | DIVORCE_FILED | DIVORCE_DECREE | DIVORCE | ANNULMENT | <EVENT_TYPE> ]    {1:1}	/* The type of event. Custom types are permitted. See the comments below for the complete list of known types. */
  +1 <<EVENT_STRUCTURE>>    {0:1}	/* Details of the event: date, place, agency, cause, cultural norms, notes, source citations, evidence qualifiers, restriction, conclusion, and modification metadata. */


INDIVIDUAL_ATTRIBUTE_RECORD :=	/* A characteristic, condition, status, classification, or descriptive property attributed to an individual. Attributes may be directly recorded in sources, derived from evidence, inferred from research, or reported through oral tradition. */
n @<XREF:INDIVIDUAL_ATTRIBUTE>@ INDIVIDUAL_ATTRIBUTE    {1:1}
  +1 INDIVIDUAL @<XREF:INDIVIDUAL>@    {1:1}	/* The individual to whom this attribute applies. */
  +1 TYPE [ CHARACTERISTIC | RESIDENCE | OCCUPATION | POSSESSION | MILITARY_RANK | CASTE | ETHNICITY | CITIZENSHIP | SSN | TITLE | CHILDREN_COUNT | MARRIAGES_COUNT | RELIGION | <ATTRIBUTE_TYPE> ]    {1:1}	/* The type of attribute. Custom types are permitted. */
  +1 VALUE <TEXT>    {0:1}	/* The value of the attribute (optional if the attribute type implies its own value, e.g., "BURIAL" implies the person was buried). */
  +1 <<DATE_STRUCTURE>>    {0:1}	/* A DATE_STRUCTURE object giving the date on which the attribute was observed, recorded, reported, or otherwise documented. */
  +1 VALID_FROM    {0:1}
    +2 <<DATE_STRUCTURE>>    {1:1}	/* The date from which this attribute is known or believed to have been valid. */
  +1 VALID_TO    {0:1}
    +2 <<DATE_STRUCTURE>>    {1:1}	/* The date until which this attribute is known or believed to have been valid. */
  +1 <<PLACE_STRUCTURE>>    {0:1}
  +1 <<SOURCE_CITATION>>    {0:M}
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}	/* Evidence qualifiers for this attribute. */
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
  +1 <<CONCLUSION_STRUCTURE>>    {0:1}	/* Specific conclusion that resolves the value or interpretation of this attribute. */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


GROUP_RECORD :=	/* A group of genealogical entities. A group can be a family, a household, a neighborhood, a club, a research group, etc. Membership in a GROUP is determined exclusively through RELATIONSHIP_RECORD objects whose OBJECT references the GROUP record and whose TYPE identifies a group membership relationship (e.g., 'group_member'). GROUP_RECORD does not directly contain a member list. This design ensures that membership is treated as a relationship with its own properties (dates, evidence, conclusions). */
n @<XREF:GROUP>@ GROUP    {1:1}
  +1 TYPE <GROUP_TYPE>    {0:1}	/* The type of the group. For example 'family', 'household', 'neighborhood', 'fraternity', 'club', 'literary society', 'association', 'organization', 'tribe', etc. Custom values are permitted. */
  +1 <<NAME_STRUCTURE>>    {0:M}	/* Names associated with the group. For a family, this name is optional. Different names may represent historical, official, customary, translated, abbreviated, or otherwise variant forms used at different times or in different contexts. */
  +1 CULTURAL_NORM @<XREF:CULTURAL_NORM>@    {0:M}
..  +1 NOTE @<XREF:NOTE>@    {0:M}
  +1 <<SOURCE_CITATION>>    {0:M}
  +1 PREFERRED_IMAGE <RESOURCE_URI>    {0:1}	/* Resource URI (following RFC 3986 specifications). */
    +2 CROP <CROP_COORDINATES>    {0:1}	/* Top-left and bottom-right coordinates of the enclosing box inside an image. Required when citing a specific part of an image-based source. */
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
  +1 <<CONCLUSION_STRUCTURE>>    {0:M}	/* Formal conclusions about this group (e.g., resolution of a conflicting marriage date, paternity, or group membership). */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */

GROUP_ATTRIBUTE_RECORD :=	/* A characteristic, condition, status, classification, or descriptive property attributed to a group. Attributes may be directly recorded in sources, derived from evidence, inferred from research, or reported through oral tradition. */
n @<XREF:GROUP_ATTRIBUTE>@ GROUP_ATTRIBUTE    {1:1}
  +1 GROUP @<XREF:GROUP>@    {1:1}	/* An xref ID of the group to which this attribute applies. */
  +1 TYPE [ RESIDENCE | CHILDREN_COUNT | SOCIAL_CLASS | <ATTRIBUTE_TYPE> ]    {1:1}	/* The classification of the attribute. Known values include RESIDENCE (place where the group is known to reside), CHILDREN_COUNT (reported number of children associated with the group), and SOCIAL_CLASS (economic or social classification of the group). Custom values are permitted. */
  +1 VALUE <TEXT>    {0:1}	/* The value assigned to the attribute. */
  +1 <<DATE_STRUCTURE>>    {0:1}	/* A DATE_STRUCTURE object giving the date on which the attribute was observed, recorded, reported, or otherwise documented. */
  +1 VALID_FROM    {0:1}
    +2 <<DATE_STRUCTURE>>    {1:1}	/* The date from which this attribute is known or believed to have been valid. */
  +1 VALID_TO    {0:1}
    +2 <<DATE_STRUCTURE>>    {1:1}	/* The date until which this attribute is known or believed to have been valid. */
  +1 <<PLACE_STRUCTURE>>    {0:1}
  +1 <<SOURCE_CITATION>>    {0:M}
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}	/* Evidence qualifiers for this attribute. */
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
  +1 <<CONCLUSION_STRUCTURE>>    {0:1}	/* Specific conclusion that resolves the value or interpretation of this attribute. */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


RELATIONSHIP_RECORD :=	/* Represents an enduring association between genealogical entities. A RELATIONSHIP describes a state, connection, or affiliation that may exist before, during, or after one or more events. Events that create, modify, recognize, or terminate a relationship SHOULD be represented separately using EVENT records. This separation allows relationships to exist independently of events (e.g., a biological parent-child relationship exists regardless of whether a birth event is documented). */
n @<XREF:RELATIONSHIP>@ RELATIONSHIP    {1:1}
  +1 SUBJECT @<XREF:ID>@|@VOID@    {1:1}	/* The entity for which the relationship is being asserted. This may be an INDIVIDUAL, GROUP, or another supported record type. If the entity is unknown, @VOID@ may be used. The SUBJECT is always the entity whose role is described by TYPE and ROLE relative to the OBJECT. */
  +1 OBJECT @<XREF:ID>@|@VOID@    {1:1}	/* The entity to which the subject is related. This may be an INDIVIDUAL, GROUP, or another supported record type. If the entity is unknown, @VOID@ may be used. */
  +1 TYPE <RELATIONSHIP_TYPE>    {1:1}	/* The specific nature of the relationship of the subject toward the object. Known values include: 'biological_child' (Relationship exists through birth), 'adoptive_child' (Relationship created through legal adoption), 'foster_child' (Temporary foster-care relationship), 'guarded_child' (Court-appointed legal guardianship relationship), 'step_child' (Relationship created through marriage and not through descent), 'civil_spouse' (Marriage recognized by civil authority), 'religious_spouse', (Marriage recognized by religious authority), 'customary_spouse' (Marriage recognized by local custom or tradition), 'cohabiting_partner' (Non-marital domestic partnership), 'engaged_partner' (Promise or agreement to marry), 'group_member' (Membership in a group), 'associate' (General association), ... */
  +1 ROLE <RELATIONSHIP_ROLE>    {0:1}	/* Indicates the function, position, capacity or responsibility held by the subject within the relationship. For example 'president', 'member', 'resident' (in a neighborhood), 'head of household', 'tribal leader'. */
  +1 STATUS <RELATIONSHIP_STATUS>    {0:1}	/* Indicates the current status of the relationship. Known values include: 'active' (Relationship currently exists), 'ended' (Relationship no longer exists), 'disputed' (Relationship is challenged by conflicting evidence), 'proposed' (Relationship has been suggested but not sufficiently demonstrated), 'unknown' (Relationship status is not known) */
  +1 <<DATE_STRUCTURE>>    {0:1}	/* A DATE_STRUCTURE object giving the date the relationship was established, recognized, or documented. */
  +1 VALID_FROM    {0:1}	/* The date from which this relationship was known to be in effect. */
    +2 <<DATE_STRUCTURE>>    {1:1}
  +1 VALID_TO    {0:1}	/* The date until which this relationship was known to be in effect. */
    +2 <<DATE_STRUCTURE>>    {1:1}
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}
..  +1 NOTE @<XREF:NOTE>@    {0:M}
  +1 <<SOURCE_CITATION>>    {0:M}
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
  +1 <<CONCLUSION_STRUCTURE>>    {0:1}	/* Specific conclusion that resolves the validity or interpretation of this relationship. */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


EVENT_STRUCTURE :=	/* Shared descriptive structure containing the details associated with an EVENT record. */
n DESCRIPTION <EVENT_DESCRIPTION_OR_ATTRIBUTE_VALUE>    {0:1}	/* Text describing a particular event pertaining to the individual or group, or the value of an attribute. */
n <<DATE_STRUCTURE>>    {0:1}	/* A DATE_STRUCTURE object giving the date of the event. */
n <<PLACE_STRUCTURE>>    {0:1}	/* A PLACE object giving the location of the event. */
n AGENCY <RESPONSIBLE_AGENCY>    {0:1}	/* The organization, institution, corporation, person, or other entity that has responsibility for the associated context. For example, an employer of a person of an associated occupation, or a church that administered rites or events, or an organization responsible for creating and/or archiving records. */
n CAUSE <CAUSE_OF_EVENT>    {0:1}	/* Used in special cases to record the reasons which precipitated an event. Normally this will be used subordinate to a death event to show cause of death, such as might be listed on a death certificate. */
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}
n CULTURAL_NORM @<XREF:CULTURAL_NORM>@    {0:M}
..n NOTE @<XREF:NOTE>@    {0:M}
n <<SOURCE_CITATION>>    {0:M}
n <<EVIDENCE_QUALIFIERS>>    {0:1}	/* Evidence qualifiers for the event. */
..n <<RESTRICTION_STRUCTURE>>    {0:1}
n <<CONCLUSION_STRUCTURE>>    {0:1}	/* Specific conclusion that resolves the value of this single event (e.g. "this date of birth is the proven one"). */
..n <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


EVENT_PARTICIPATION_RECORD :=	/* Associates an entity with an event and, when known, describes the role played by the entity within that event. All participation in events SHALL be represented through EVENT_PARTICIPATION records. This design allows the same event to have multiple participants (e.g., a marriage has two spouses) and the same entity to participate in multiple events (e.g., a person can be born, married, and buried). */
n @<XREF:EVENT_PARTICIPATION>@ EVENT_PARTICIPATION    {1:1}
  +1 EVENT @<XREF:EVENT>@    {1:1}	/* The event in which the entity participated. */
  +1 ENTITY @<XREF:ID>@    {1:1}	/* The entity that participated in the event. */
  +1 ROLE <ROLE_IN_EVENT>    {0:1}	/* The role the entity played in the event. Known values are: CHILD, PARENT, SPOUSE, POWER_OF_ATTORNEY, PRISONER, etc. This field is optional because the role may be unknown or not applicable. */
  +1 <<SOURCE_CITATION>>    {0:M}
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}
..  +1 NOTE @<XREF:NOTE>@    {0:M}
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


PLACE_RECORD :=	/* A geographical, administrative, ecclesiastical, cadastral, historical, or physical location. Places may be linked together using PLACE_RELATIONSHIP records in order to model changing jurisdictions and historical geography. */
n @<XREF:PLACE>@ PLACE    {1:1}
  +1 <<NAME_STRUCTURE>>    {1:M}	/* The name of the place formatted for display and address generation. */
  +1 TYPE <PLACE_TYPE>    {0:1}	/* The classification of the place. Known values include: 'address', 'building', 'street', 'hamlet', 'village', 'town', 'municipality', 'city', 'metropolitan_area', 'county', 'province', 'department', 'district', 'region', 'macro_region', 'country', 'empire', 'parish', 'diocese', 'cemetery', 'archive', 'unknown'. Custom values are permitted. */
  +1 MAP    {0:1}	/* Contains the location of a place in a Global Positioning System. */
    +2 LATITUDE <PLACE_LATITUDE>    {1:1}	/* The value specifying the latitudinal coordinate of the place name (as defined by ISO 6709: https://en.wikipedia.org/wiki/ISO_6709). */
    +2 LONGITUDE <PLACE_LONGITUDE>    {1:1}	/* The value specifying the longitudinal coordinate of the place name (as defined by ISO 6709: https://en.wikipedia.org/wiki/ISO_6709). */
    +2 <<EVIDENCE_QUALIFIERS>>    {0:1}
  +1 <<SOURCE_CITATION>>    {0:M}
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
  +1 <<CONCLUSION_STRUCTURE>>    {0:M}	/* One or more formal conclusions regarding this place. */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */

PLACE_STRUCTURE :=	/* Reference to a PLACE record together with location-specific citations and evidence qualifiers. */
n PLACE @<XREF:PLACE>@    {1:1}
  +1 <<SOURCE_CITATION>>    {0:M}
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}

PLACE_RELATIONSHIP_RECORD :=	/* A relationship connecting two place records. Place relationships are used to represent geographic, administrative, ecclesiastical, judicial, cadastral, postal, or historical associations between places. These relationships may change over time and can therefore be bounded by validity dates. */
n @<XREF:PLACE_RELATIONSHIP>@ PLACE_RELATIONSHIP    {1:1}
  +1 SUBJECT @<XREF:PLACE>@    {1:1}	/* The place for which the relationship is asserted. The SUBJECT is always the place whose role is described by TYPE relative to the OBJECT. */
  +1 OBJECT @<XREF:PLACE>@    {1:1}	/* The place to which the subject is related. */
  +1 TYPE <PLACE_RELATIONSHIP_TYPE>    {1:1}	/* The specific nature of the relationship of the subject toward the object. Known values include: 'administrative_part_of' (subject is part of an administrative jurisdiction, e.g., Treviso → Veneto), 'geographic_part_of' (subject is geographically contained within another place), 'ecclesiastical_part_of' (subject belongs to an ecclesiastical jurisdiction such as a parish, diocese, or archdiocese), 'judicial_part_of' (subject belongs to a court, district, or judicial jurisdiction), 'cadastral_part_of' (subject belongs to a cadastral or land-records district). Custom values are permitted. */
  +1 VALID_FROM    {0:1}	/* The date from which this place relationship is known or believed to have been valid. */
    +2 <<DATE_STRUCTURE>>    {1:1}
  +1 VALID_TO    {0:1}	/* The date until which this place relationship is known or believed to have been valid. */
    +2 <<DATE_STRUCTURE>>    {1:1}
  +1 NOTE <TEXT>    {0:M}	/* A note containing commentary, interpretation, or discussion related to this place relationship. */
  +1 <<SOURCE_CITATION>>    {0:M}	/* A list of SOURCE_CITATION objects supporting the existence, interpretation, or dating of this place relationship. */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


NOTE_RECORD :=
n @<XREF:NOTE>@ NOTE    {1:1}
..  +1 TITLE <TEXT>    {0:1}	/* Note title. */
..  +1 VALUE <SUBMITTER_TEXT>    {1:1}	/* Comments or opinions from the submitter following markdown language. Reference to structures in this file can be written as `[text](@<XREF:ID>@)`, "confidential" data can be written as `[text](confidential)`. */
..  +1 MIME <MIME_TYPE>    {0:1}	/* e.g., text/html, text/markdown. */
..  +1 LOCALE <LOCALE_CODE>    {0:1}	/* The locale identifier for the note (as defined by IETF BCP 47: https://tools.ietf.org/html/bcp47). */
..  +1 TRANSLATION    {0:M}
..    +2 VALUE <TEXT>    {1:1}	/* A translated version of the note. */
..    +2 LOCALE <LOCALE_CODE>    {0:1}	/* The locale identifier for the translated note (as defined by IETF BCP 47: https://tools.ietf.org/html/bcp47). */
  +1 <<SOURCE_CITATION>>    {0:M}	/* A list of SOURCE_CITATION objects referenced by this source. */
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


ONGOING
REPOSITORY_RECORD :=	/* A representation of where a source or set of sources is located. May be formal, like a library, or informal, like the owner of a family book. */
n @<XREF:REPOSITORY>@ REPOSITORY    {1:1}
  +1 <<NAME_STRUCTURE>>    {1:M}	/* The official name of the archive in which the stated source material is stored. */
..  +1 CUSTODIAN @<XREF:INDIVIDUAL>@    {0:1}	/* An xref ID of the individual acting as custodian of the repository or its source material. */
  +1 <<PLACE_STRUCTURE>>    {0:1}	/* A PLACE object giving the location of the repository. */
  +1 <<CONTACT_STRUCTURE>>    {0:M}
..  +1 NOTE @<XREF:NOTE>@    {0:M}
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */

REPOSITORY_CITATION :=	/* Citation of a repository holding a source or source collection. Allows recording repository-specific call numbers, shelf marks, page references, entry identifiers, or other retrieval information. */
n REPOSITORY @<XREF:REPOSITORY>@    {1:1}	/* A list of xref ID of repository records who owns this source. */
  +1 LOCATION <WHERE_WITHIN_REPOSITORY>    {0:1}	/* A note on the location of the document inside the repository (Usually an identification or reference description used to file and retrieve items from the holdings of a repository, or the page and number of the entry inside a registry). */
  +1 NOTE <TEXT>    {0:1}	/* Free-text note. */


CONTACT_STRUCTURE :=	/* Machine-readable contact information for a person, organization, repository, submitter, or other entity. */
n CONTACT <CONTACT_ADDRESS>    {1:1}	/* A phone number, an electronic address that can be used for contact such as an email address following RFC 5322 specifications, or a World Wide Web page address following RFC 3986 specifications, or any other type of contact address. */
  +1 TYPE <CONTACT_TYPE>    {0:1}	/* Indicates the phone number type (work, home, blog, personal, social, etc.). */
  +1 CALLER_ID <TEXT>    {0:1}	/* Indicates the name of the person associated with this contact. */
..    +2 <<TEXT_VALUE_VARIANT>>    {0:M}
  +1 NOTE <TEXT>    {0:1}	/* Free-text note. */
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}


CULTURAL_NORM_RECORD :=	/* Genealogical events and individual characteristics at various times and places are influenced by customs, practices, and conditions of their culture. This affects the interpretation of recorded information and the assumptions made about probable genealogical events when there is no or little known information. For example, a birth year can be estimated by knowing the date of a religious ceremony which normally involves a child of 12 years old. */
n @<XREF:CULTURAL_NORM>@ CULTURAL_NORM    {1:1}
  +1 TITLE <CULTURAL_NORM_DESCRIPTIVE_TITLE>    {0:1}	/* The title of the rule. */
  +1 <<PLACE_STRUCTURE>>    {0:1}	/* A PLACE object giving the location in which this cultural norm was in effect. */
  +1 VALID_FROM    {0:1}	/* The date from which this cultural norm was in effect. */
    +2 <<DATE_STRUCTURE>>    {1:1}
  +1 VALID_TO    {0:1}	/* The date until which this cultural norm was in effect. */
    +2 <<DATE_STRUCTURE>>    {1:1}
..  +1 NOTE @<XREF:NOTE>@    {0:M}
  +1 <<SOURCE_CITATION>>    {0:M}
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


SOURCE_RECORD :=	/* A source from which genealogical information is derived. A source may represent a document, publication, archive record, inscription, oral testimony, database entry, image, audio recording, or any other evidence-bearing artifact. */
n @<XREF:SOURCE>@ SOURCE    {1:1}
  +1 TITLE    {1:M}	/* The title of the work, record, or item and, when appropriate, the title of the larger work or series of which it is a part. */
    +2 <<TEXT_VALUE>>    {1:1}
  +1 AUTHOR <SOURCE_ORIGINATOR>    {0:1}	/* The person, agency, or entity who created the record. For a published work, this could be the author, compiler, transcriber, abstractor, or editor. For an unpublished source, this may be an individual, a government agency, church organization, or private organization, etc. */
  +1 <<PLACE_STRUCTURE>>    {0:1}	/* A PLACE object giving the place this source was created. */
  +1 <<DATE_STRUCTURE>>    {0:1}	/* A DATE_STRUCTURE object giving the date this source was created. */
  +1 PUBLISHER <SOURCE_PUBLISHER>    {0:1}	/* Name of the publisher of the publication. */
  +1 <<REPOSITORY_CITATION>>    {0:M}	/* A list of xref ID of repository records who owns this source. */
  +1 MEDIA_TYPE <SOURCE_MEDIA_TYPE>    {0:1}	/* The medium of the source. Known values include "audio", "book", "card", "electronic", "fiche", "film", "magazine", "manuscript", "map", "newspaper", "photo", "tombstone", "video". */
  +1 <<DOCUMENT_STRUCTURE>>    {0:M}	/* A document reference to the auxiliary data to be linked to this context. */
  +1 <<SOURCE_CITATION>>    {0:M}	/* A list of SOURCE_CITATION objects referenced by this source. */
..  +1 NOTE @<XREF:NOTE>@    {0:M}	/* An xref ID of a note record. May contain information to identify a book (author, publisher, ISBN code, ...), a digital archive (website name, creator, ...), a microfilm (record title, record file, collection, film ID, roll number, ...), etc. */
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
  +1 <<CONCLUSION_STRUCTURE>>    {0:M}	/* One or more formal conclusions regarding this source. */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */

SOURCE_CITATION :=	/* Reference to a SOURCE record used as evidence for an assertion, together with optional location, notes, crop coordinates, and evidence assessment. */
n SOURCE @<XREF:SOURCE>@    {1:1}
  +1 LOCATION <WHERE_WITHIN_SOURCE>    {0:1}	/* Specific location within the information referenced. The data in this field should be in the form of a label and value pair (e.g., 'Film: 1234567, Frame: 344, Line: 28', or 'Volume: 2, Page: 143, Entry: 17'). */
  +1 CROP <CROP_COORDINATES>    {0:1}	/* Top-left and bottom-right coordinates of the enclosing box inside an image. */
  +1 NOTE <TEXT>    {0:M}	/* Free-text note. */
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}


DOCUMENT_STRUCTURE :=	/* A digital or physical representation associated with a source, such as an image, PDF, scan, transcription, audio recording, video, or other media resource. */
n FILE <RESOURCE_URI>    {1:1}	/* Resource URI (following RFC 3986 specifications). */
  +1 SPHERICAL Y    {0:1}	/* Whether the file is spherical (panorama/360° or truly spherical U/V mapped). */
  +1 MAPPING <MAPPING_TYPE>    {0:1}	/* The projection/mapping/coordinate system of an image. Known values include "spherical_UV" (spherical UV mapped image), "cylindrical_equirectangular_horizontal"/"cylindrical_equirectangular_vertical" (equirectangular image). */
  +1 DESCRIPTION <DOCUMENT_DESCRIPTION>    {0:1}	/* A description of the source. For example 'cover', 'back', etc. */
  +1 EXTRACT <TEXTED_TEXT_FROM_SOURCE>    {0:M}	/* A verbatim copy of any description contained within the source. This indicates notes or text that are actually contained in the source document, not the submitter's opinion about the source. */
    +2 TYPE <EXTRACT_TYPE>    {1:1}	/* Can be 'transcript' (indicates a complete, verbatim copy of the document), 'extract' (a verbatim copy of part of the document), or 'abstract' (a reworded summarization of the document content). */
    +2 LOCALE <EXTRACT_LOCALE_CODE>    {0:1}	/* The locale identifier for the source (as defined by IETF BCP 47: https://tools.ietf.org/html/bcp47). */
..  +1 NOTE @<XREF:NOTE>@    {0:M}
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}


DATE_STRUCTURE :=	/* Used for historical, documentary, and genealogical dates whose value may require interpretation, source evaluation, calendar conversion, or evidentiary analysis. Administrative dates such as creation dates, update dates, search dates, expiration dates, and other system metadata should use the simpler DATE datatype instead. */
n DATE    {1:1}	/* A date object giving the date that this event happened (usually derived from the original input). */
  +1 <<DATE_VALUE>>    {1:1}
  +1 <<SOURCE_CITATION>>    {0:M}
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}

DATE_VALUE :=	/* Represents the nature of a date assertion. A date can be a single point, an uncertainty interval, or a duration spanning an actual period of time. */
[
n VALUE    {1:1}	/* A single point in time. Unless marked as APPROXIMATE, the value is accepted as recorded, derived, or concluded from the available evidence. */
  +1 <<QUALIFIED_DATE>>    {1:1}
|
n BOUNDED    {1:1}	/* The exact date is unknown but is known to fall within the specified interval. The interval represents uncertainty about the date itself, not the duration of the fact. An omitted bound represents an open-ended limit. */
  +1 NOT_BEFORE    {0:1}	/* At least one of NOT_BEFORE or NOT_AFTER is required. */
    +2 <<QUALIFIED_DATE>>    {1:1}
  +1 NOT_AFTER    {0:1}	/* At least one of NOT_BEFORE or NOT_AFTER is required. */
    +2 <<QUALIFIED_DATE>>    {1:1}
|
n SPANNING    {1:1}	/* The fact itself extends across the specified interval. Unlike BOUNDED, the interval does not represent uncertainty about a date; it represents the actual duration of the event, status, relationship, or condition. */
  +1 FROM    {0:1}	/* At least one of FROM or TO is required. */
    +2 <<QUALIFIED_DATE>>    {1:1}
  +1 TO    {0:1}	/* At least one of FROM or TO is required. */
    +2 <<QUALIFIED_DATE>>    {1:1}
]

QUALIFIED_DATE :=	/* A single point in time, optionally marked as an estimate rather than a value accepted as recorded/derived. This is the sole point of recursion in the grammar: it lets an interval's endpoint (or a standalone date) carry its own approximation, without allowing intervals to nest inside intervals. */
n <<SINGLE_DATE>>    {1:1}
n APPROXIMATE    {0:1}	/* Present only when this specific point is itself an estimate. The exact date is unknown, but this value is considered a reasonable approximation. */
  +1 BASIS <APPROXIMATION_BASIS>    {0:1}	/* 'stated' (the source itself says "about"/"around"), 'calculated' (arithmetically derived from another known date, e.g., age at death), 'conventional' (deduced by applying a cultural norm typical of the period/place), 'unspecified'. */
  +1 CULTURAL_NORM @<XREF:CULTURAL_NORM>@    {0:1}	/* mandatory in practice when BASIS = 'conventional': it is the record that justifies the estimate. */
  +1 MARGIN <DURATION>    {0:1}	/* e.g., 'P2Y' = plus/minus 2 years, when the margin is quantifiable (as defined by ISO 8601 Durations: https://en.wikipedia.org/wiki/ISO_8601#Durations). */

SINGLE_DATE :=	/* A single point in time expressed at an explicitly declared level of precision. The granularity is determined by the selected representation and is not inferred from formatting conventions. */
[
n ISO <DATE>    {1:1}	/* A calendar date (as defined by ISO 8601: https://en.wikipedia.org/wiki/ISO_8601). */
  +1 CALENDAR <CALENDAR_TYPE>    {1:1}	/* A calendar type. Known values: 'gregorian', 'julian', 'islamic', 'hebrew', 'chinese', 'indian', 'buddhist', 'french-republican', 'coptic', 'soviet eternal', 'ethiopian', 'mayan', ... */
|
n CENTURY <ORDINAL>    {1:1}	/* A century designation, such as 15 for the 15th century. Optional qualifiers may indicate a subdivision of the century. */
  +1 PART <CENTURY_PART>    {0:1}	/* A subdivision of the century: 'first_quarter', 'second_quarter', 'third_quarter', 'fourth_quarter', 'first_half', 'second_half', 'early', 'mid', 'late'. */
  +1 CALENDAR <CALENDAR_TYPE>    {1:1}	/* A calendar type. Known values: 'gregorian', 'julian', 'islamic', 'hebrew', 'chinese', 'indian', 'buddhist', 'french-republican', 'coptic', 'soviet eternal', 'ethiopian', 'mayan', ... */
|
n DECADE <DECADE_START_YEAR>    {1:1}	/* A decade identified by its starting year. For example, 1490 represents the decade commonly referred to as the '1490s'. */
  +1 CALENDAR <CALENDAR_TYPE>    {1:1}	/* A calendar type. Known values: 'gregorian', 'julian', 'islamic', 'hebrew', 'chinese', 'indian', 'buddhist', 'french-republican', 'coptic', 'soviet eternal', 'ethiopian', 'mayan', ... */
]


HISTORIC_EVENT_RECORD :=	/* A significant historical event that may provide context for genealogical research. Historic events can explain migrations, mortality patterns, social changes, legal reforms, economic conditions, territorial changes, epidemics, wars, natural disasters, or scientific discoveries that affected individuals, families, groups, or places. Unlike EVENT records, a HISTORIC_EVENT is not normally tied to a specific individual or group. It exists primarily to provide historical, legal, social, environmental, or political context. */
n @<XREF:HISTORIC_EVENT>@ HISTORIC_EVENT    {1:1}
  +1 TITLE <HISTORIC_EVENT_DESCRIPTIVE_TITLE>    {0:1}	/* The title of the rule. */
  +1 <<DATE_STRUCTURE>>    {0:1}	/* The date on which this historic event happened. */
  +1 <<PLACE_STRUCTURE>>    {0:1}	/* The place in which this historic event happened. */
..  +1 NOTE @<XREF:NOTE>@    {0:M}
  +1 <<SOURCE_CITATION>>    {0:M}
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


RESEARCH_STATUS_RECORD :=	/* Defines a research question and its overall status. RESEARCH_LOG_RECORD entries document the activities performed to answer this question. Multiple logs may contribute to a single status, and a single log may contribute to multiple statuses (via RESEARCH references). */
n @<XREF:RESEARCH_STATUS>@ RESEARCH_STATUS    {1:1}
  +1 STATUS <RESEARCH_STATUS>    {0:1}	/* Research status: 'active' (currently being searched), 'paused', 'completed' (all the information has been found), 'blocked'. */
  +1 QUESTION <RESEARCH_QUESTION>    {1:1}	/* The research question being investigated. */
  +1 PRIORITY <RESEARCH_PRIORITY>    {0:1}	/* 'high', 'medium', 'low'. */
  +1 ASSOCIATION @<XREF:ID>@|@VOID@    {0:M}	/* An xref ID of a record that lacks research. */
    +2 NAME <TEXT>    {0:1}	/* The name of the individual, only for VOID reference. */
  +1 BLOCKED_BY @<XREF:RESEARCH_STATUS>@    {0:M}	/* If this research is blocked by another unresolved question. */
  +1 PLAN <TEXT>    {0:1}	/* Detailed description of what needs to be done. */
  +1 RESOLUTION <TEXT>    {0:1}	/* How the question was resolved, if completed. */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


RESEARCH_LOG_RECORD :=	/* Documents a specific research activity performed to answer one or more research questions. Each log entry is a point-in-time record of what was done, what was found, and what the next steps are. */
n @<XREF:RESEARCH_LOG>@ RESEARCH_LOG    {1:1}
  +1 ACTION <TEXT>    {1:1}	/* Description of the research activity that was performed. For example, a repository search, source review, correspondence, or archive consultation. */
  +1 TARGET @<XREF:ID>@|@VOID@    {0:1}	/* An xref ID of a record that was the subject of the research activity. This may reference any supported record type. If the target is not represented elsewhere in the file, @VOID@ may be used. */
  +1 SOURCE @<XREF:SOURCE>@    {0:M}	/* An xref ID of a source record that was consulted, reviewed, searched, or discovered during the research activity. */
  +1 SEARCH_SCOPE <SEARCH_SCOPE_DESCRIPTION>    {0:1}	/* What was searched: "entire_volume", "pages_10_to_20", "index_only", "selected_entries". */
  +1 SEARCH_OUTCOME <SEARCH_OUTCOME>    {0:1}	/* The outcome of the research activity: "found", "not_found", "partially_found", "unreadable", or "destroyed". */
  +1 FINDING <TEXT>    {0:1}	/* A note describing the outcome, findings, observations, or conclusions of the research activity. */
  +1 NEXT_STEP <TEXT>    {0:1}	/* What to do next as a result of this research activity. */
  +1 FOLLOW_UP @<XREF:RESEARCH_LOG>@    {0:M}	/* Reference to the next research log entry that follows from this one. */
  +1 RESEARCH @<XREF:RESEARCH_STATUS>@    {0:M}	/* An xref ID of a research question or research objective to which this research activity contributes. */
  +1 DATE <DATE>    {1:1}	/* The date of when the search was performed (as defined by ISO 8601: https://en.wikipedia.org/wiki/ISO_8601). */
..  +1 <<RESTRICTION_STRUCTURE>>    {0:1}
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


..RESTRICTION_STRUCTURE :=	/* Specifies how this structure may be displayed, exported, or distributed. The restriction expresses the intent of the data contributor and should be respected regardless of any automatic privacy policy applied by the receiving system. */
..n RESTRICTION    {1:1}
..  +1 LEVEL <RESTRICTION_LEVEL>    {1:1}	/* Known values are: 'public' (information may be freely displayed, exported, and distributed), 'restricted' (information should be treated with caution and may be omitted from public reports, exports, or distributions), and 'confidential' (information should not normally be displayed, exported, or included in public distributions). */
..  +1 RATIONALE <TEXT>    {0:1}	/* e.g., 'Living individual', 'Repository license forbids redistribution', etc. */
..  +1 EXPIRES <DATE>    {0:1}	/* The date this restriction expires (as defined by ISO 8601: https://en.wikipedia.org/wiki/ISO_8601). */


..MODIFICATION_STRUCTURE :=	/* Audit trail describing when the structure was created and subsequently modified. This information concerns the record itself, not the historical subject represented by the record. */
..n CREATION    {1:1}	/* An object giving the date of the creation of this structure. */
..  +1 DATE <DATE>    {1:1}	/* A date object giving the date of the creation of this structure (as defined by ISO 8601: https://en.wikipedia.org/wiki/ISO_8601). */
..  +1 COMMENT <TEXT>    {0:1}
..n UPDATE    {0:M}	/* An object giving the date of the changing of this structure. */
..  +1 DATE <DATE>    {1:1}	/* A date object giving the date of the changing of this structure (as defined by ISO 8601: https://en.wikipedia.org/wiki/ISO_8601). */
..  +1 COMMENT <TEXT>    {0:1}


CONCLUSION_STRUCTURE :=	/* A formal statement that resolves a conflict between conflicting evidence by selecting the hypothesis deemed most truthful based on a critical analysis of the sources. */
n CONCLUSION    {1:1}
  +1 CONTEXT <RESOLUTION_CONTEXT>    {1:1}	/* The specific context that is resolved, for example, "birth_date", "marriage_place", "parentage", "death_cause", "relationship_type". */
  +1 RESOLVES @<XREF:ID>@    {0:M}	/* A pointer to one or more conflicting events (or associations) that this conclusion is intended to resolve. */
  +1 PREFERRED @<XREF:ID>@    {0:1}	/* The record (usually an EVENT, but can be a GROUP or INDIVIDUAL or PLACE etc.) that this conclusion determines to be the true one. If the conclusion is purely negative (e.g., "none of the hypotheses are valid"), this field can be omitted. */
  +1 PROOF_STATUS <PROOF_STATUS_VALUE>    {1:1}	/* The status of the test according to the genealogical standard. Permitted values: "unresearched" (not yet sought), "conflicting_evidence" (the evidence is conflicting, none prevails), "supported" (preponderance of evidence, but not absolute certainty), "proven" (proven according to the Genealogical Proof Standard), "disproven" (proven false). */
  +1 NARRATIVE <TEXT>    {0:1}	/* A discursive text that explains the logical reasoning, the sources evaluated and the reason why this conclusion was chosen. */
  +1 RESEARCH @<XREF:RESEARCH_STATUS>@   {0:M}	/* References to research questions that led to this conclusion. */
  +1 DATE <DATE>    {0:1}	/* The date the researcher made this conclusion (as defined by ISO 8601: https://en.wikipedia.org/wiki/ISO_8601). */
  +1 <<SOURCE_CITATION>>    {0:M}	/* Any sources that support the conclusion itself (e.g., a methodology treatise, or a secondary source that has already resolved the conflict). */


IDENTITY_HYPOTHESIS_RECORD :=	/* Represents a research hypothesis that two records may describe the same real-world entity. The hypothesis itself does not establish identity; it merely records the possibility pending evaluation. */
n @<XREF:IDENTITY_HYPOTHESIS>@ IDENTITY_HYPOTHESIS    {1:1}
  +1 SUBJECT @<XREF:ID>@    {1:1}	/* The first record in the identity hypothesis. */
  +1 CANDIDATE @<XREF:ID>@    {1:1}	/* The second record in the identity hypothesis. */
  +1 <<SOURCE_CITATION>>    {0:M}
  +1 <<EVIDENCE_QUALIFIERS>>    {0:1}
  +1 COMMENT <TEXT>    {0:1}	/* A note explaining the basis for the possible duplicate hypothesis. */
..  +1 <<MODIFICATION_STRUCTURE>>    {1:1}	/* Creation and update metadata for this record. */


EVIDENCE_QUALIFIERS :=	/* Qualifiers describing the confidence assigned to an assertion and the quality of evidence supporting that assertion. */
n CERTAINTY <CERTAINTY_ASSESSMENT>    {0:1}	/* Measures confidence in the assertion itself. An assessment of whether the asserted fact, event, relationship, attribute, or association is believed to be correct. This reflects the researcher's confidence in the assertion itself, after evaluating the available evidence. Known values: proven: supported by sufficient evidence and accepted as correct; challenged: questioned by conflicting, incomplete, or uncertain evidence; disproven: demonstrated to be incorrect based on available evidence.
*/
n CREDIBILITY <CREDIBILITY_ASSESSMENT>    {0:1}	/* Measures confidence in the supporting evidence. An assessment of the strength and reliability of the evidence supporting this assertion. Unlike CERTAINTY, which evaluates whether the assertion is believed to be correct, CREDIBILITY evaluates the quality of the evidence available. Values: 0: speculative, estimated, or unsupported; 1: weak evidence, limited support, or evidence of questionable reliability; 2: moderate evidence, reasonably reliable but incomplete or indirect; 3: strong evidence, multiple reliable sources, or evidence considered highly convincing.
*/
