	source S1388 {
		title.value birth Trevisan Rosa Maria 19090203
		repository.repository R2
		media M1798
		media M1799
		note {
			title Text from source
			text Il dichiarante mi ha denunciato la nascita suddetta, nella sua qualità di ufficiale a ciò delegato dalla Direzione di questo Ospitale Civile ed Istituto Esposti, in cui la Michieletto Maria Anna fu accolta ed ha partorito la bambina predetta ed in luogo del marito della medesima perché assente dal Comune. Lo stesso dichiarante fu poi da me dispensato dal presentarmi la bambina per ragioni igieniche, dopo essermi altrimenti accertato della verità della nascita.
			audit.creation.date 2021-03-09T19:39:32Z
		}
		audit.creation.date 2021-03-09T19:39:32Z
	}

