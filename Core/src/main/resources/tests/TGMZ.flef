		title.value birth Scomparin Mario 19260215
		repository.repository R2
		media M2106
		media M2107
		note {
			title Text from source
			text La dichiarante mi ha denunciato la nascita suddetta per avere nella preindicata sua qualità prestati i sussidi dell'arte sua nell'atto del parto della Busato Italia ed in luogo del marito di questa il quale trovasi a letto ammalato. Dispensai altresí la presentazione causa la lunga distanza, dopo essermi altrimenti accertato della verità della nascita.
			audit.creation.date 2021-05-03T00:00:00Z
		}
