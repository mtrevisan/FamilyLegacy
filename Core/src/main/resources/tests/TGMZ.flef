			calendar gregorian
		}
		valid_to.value.bounded.not_before {
			value.full_date SEP 2000
			calendar gregorian
		}
		place.place P1501
		note {
			text """
In September 2000, Rogério began a new phase of production in Mato Grosso, identifying Fazenda Paraíso, located in the municipality of Canarana, MT. In 2003, he also acquired Fazenda Vitória. A partnership dissolution took place in 2013, and since then, Fazenda Paraíso has been under the sole management of Rogério Mazzutti.

https://www.empresaemcrise.com/post/canarana-mt-produtor-rural-rog%C3%A9rio-mazzutti-entra-em-recupera%C3%A7%C3%A3o-judicial"""
			audit.creation.date 2026-10-26T00:00:00Z
		}
		audit.creation.date 2026-10-26T00:00:00Z
