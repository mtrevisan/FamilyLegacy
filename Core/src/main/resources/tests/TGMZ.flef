	media M2403 {
		uri C:\mauro\heritage\My Genealogy Projects\Trevisan (Dorato)-Gallinaro-Masutti (Manfrin)-Zaros (Basso)\Photos\deeds\dowry 15260521 Favro Fiorenza.jpg
		kind image
		description dowry 15260521 Favro Fiorenza
		note {
			title Format
			text jpg
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			title Date
			text 21 MAY 1526
			audit.creation.date 2026-10-26T00:00:00Z
		}
		audit.creation.date 2026-10-26T00:00:00Z
	}

	source S1900 {
		title.value dowry 15260521 Favro Fiorenza
		author.text nodaro Sermazia Giovanni Antonio
		repository.repository R2
		media M2403
		note {
			text busta 884
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			title Text from source
			text """
1526 . adi 21 mazo beni mobeli estimadi p[er] ser nicolo peliza et mi Zanant[oni] p[er]aza
dati p[er] ser hier[oni]mo favro da Scandolara dati i[n] dota a fiore[n]za
sua fia mogiere d[e] agnol trivisa[n] fiuol d[e] marchioro trivisan
Et p[rima] p[er] un leto zoe la entima braza 22 val ... l[ibras] 13 s[oldos] 4
I[tem] un par d[e] linzuoli d[e] lin val ... l[ibras] 12 s[oldos] 8
I[tem] quat[r]o lire d[e] piuma nuova val ... l[ibras] 2 s[oldos]
I[tem] u[n] par d[e] camise da nuovo val ... l[ibras] 4 s[oldos]
I[tem] u[n] par d[e] camise usade val ... l[ibras] 2 s[oldos] 10
I[tem] quat[r]o fazuoli d[e] lin da nuovo val ... l[ibras] 5 s[oldos] 15
I[tem] 3 fazoleti et una scufia cu[m] una binda d[e] sea
et cu[m] u[n] puocho d[e] sea val ... l[ibras] 2 s[oldos] 10
I[tem] una meza traversa cu[m] u[n] fazuol usado val ... l[ibras] 1 s[oldos] 15
I[tem] una cotola d[e] c[anev]o val ... l[ibras] 2 s[oldos]
I[tem] u[n] par d[e] manege d[e] camisa et do peze da collo l[ibras] s[oldos] 12
I[tem] u[n] gaba[n] d[e] lin bianc[h]o usado val ... l[ibras] 3 s[oldos] 5
I[tem] una cotola biancha cu[m] cassi d[e] pignola ... l[ibras] 5 s[oldos] 10
I[tem] una bonbasina biancha fornida val ... l[ibras] 11 s[oldos] 4
I[tem] una cotolla negra cu[m] cassi d[e] pignola val ... l[ibras] 6 s[oldos] 4
I[tem] lire do d[e] filo d[e] c[anev]o do d[e] lin : et o[n]ze 7 d[e] filo
da fazuoli in tuto ... l[ibras] 11 s[oldos] 10
I[tem] filo d[e] c[anev]o lire una e meza et lire una d[e] li[n] grosso l[ibras] 2 s[oldos]
I[tem] onze nuove d[e] lin spadola val ... l[ibras] s[oldos] 8
I[tem] do entimelle d[e] c[anev]o usade val ... l[ibras] s[oldos] 10
I[tem] u[n]o coffano depento val ... l[ibras] 10 s[oldos]
I[tem] una cotola, et u[n] gaba[n] d[e] c[anev]o usade val ... l[ibras] 2 s[oldos]"""
			audit.creation.date 2021-06-22T22:51:19Z
		}
		audit.creation.date 2021-06-22T22:51:19Z
	}

	media M2404 {
		uri C:\mauro\heritage\My Genealogy Projects\Trevisan (Dorato)-Gallinaro-Masutti (Manfrin)-Zaros (Basso)\Photos\deeds\deed 15251015 Trivisani Sebastianus + Trivisanus Menegus.jpg
