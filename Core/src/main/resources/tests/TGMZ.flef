	source S127 {
		title.value deed 15710127 Trevisani Franciscus
		author.text nodaro Sermacia Cypriani
		repository.repository R2
		media M116
		media M117
		media M118
		note {
			text busta 847, carta 1
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			title Text from source
			text """
1571 : Indict[ione] 14 Die sabbati vigesimo septimo
m[ens]is Januarij Tarvisij in off[ici]o sanitatis
p[rese]ntibus ser vince[n]tio erithea cive Tar[visi]no q[uodam]
ser Alberti, et Dominico paduano q[uondam] pe=
tri habitatore in villa p[re]ganzolli t[es]tibus
vocatis et rogatis

Ibiq[ue] ser franciscus q[uondam] ser andreæ trivi=
sani de Scandolaria p[er] se suos h[e]r[e]des
ad proprium et[iam] Dedit et vendidit ser
Dominico Trivisano eius fratri p[rese]nti
p[er] se et h[e]r[e]dibus suis recipienti et stipu[lan]ti
unum cortivu[m] cum juribus suis posi=
tum in villa p[re]dicta d[e] Scandolaria ibi
de p[rese]nti habitat dictus venditor cui
coheret à mane Trivisanus de Tri=
visanis d[e] dicta villa, à meridie via
pu[bli]ca, à sero dictus emptor, et à mo[n]te
venditor cum sua habitationes sal[vis]
p[re]cio ducator[um] septem à l[ibras] 6 s[oldos] 4 p[ro] ducato
quos denarios, et quod p[re]cium venditor
\
confessus fuit habuisse et recepisse
ab emptore p[er] antea omni except[ion]e
remota pro quibus sic habitis et re=
ceptis satisfactum vocavit et finem
fecit in forma ad habendum et[iam]
pacto redimendi quandocu[m]q[ue] in ter[mi]no
annor[um] septem prox[ime] futuror[um] eode[m]
p[re]cio et exp[en]sis infra[scrip]ti quo elapso,
et no[n] facta recup[er]atione liberu[m] sit
emptori de p[re]dictis stridationes Impe=
trare cum promissione de evictio=
ne et legitima defensione sub obligat[ione]
o[mn]ium bonor[um] suor[um] p[rese]ntium et fut[urorum] : quam
venditionem et o[mn]ia sup[rascrip]ta promisit ha=
bere firma, et rata sub obligat[ione] p[re]dicta &

Eo die loco et quibus sup[ra] p[rese]ntibus Ibiq[ue]
ser franc[iscu]s Trivisanus q[uondam] ser andreæ
de Scandolaria p[er] se et h[e]r[e]des suos dedit cessit,
et renu[n]tiavit ser d[o]m[eni]co trivisano eius fratri p[rese]nti r[ecipie]nti et stip[ulan]ti p[er] se et suos h[e]redibus o[mn]ia et singula sua jura
\
quæ et quas habet v[e]l habere posset in
campo dimidio terræ posito in
villa p[re]dicta d[e] Scandolaria in loco ditto
della dalla via pu[bli]ca d[e]l cortivo cui coheret à duab[us] partib[us]
ser antonius Joppatus d[e] dicta villa
à sero dictus emptor, et à mo[n]te via pu[bli]ca
salvis et[iam] p[re]cio ducator[um] decem à l[ibras] 6 s[oldos] 4
p[ro] ducato quos denarios et q[uo]d p[re]cium
venditor confessus fuit habuisse et
recepisse ab emptore p[ro] antea omni
exceptione remota pro quibus sic
habitis et receptis satisfactum vocavit
et finem fecit in forma Ad haben=
dum et[iam] cum promissione de evic=
tione, et legitima defensione sub
obligatione o[mn]ium bonor[um] suor[um] p[rese]ntium
et futuror[um] quam cessione[m], et re=
nu[n]tiam et o[mn]ia sup[rascrip]ta dictus cedens
promisit habere firma, et rata sub
obligatione p[re]dicta"""
			audit.creation.date 2026-07-06T11:46:24Z
		}
		audit.creation.date 2026-07-06T11:46:24Z
	}

	media M119 {
