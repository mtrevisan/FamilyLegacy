		title.value birth Masutti Olindo Stefano 19101226
		repository.repository R29
		media M1840
		note {
			title Text from source
			text La dichiarante mi ha denunciata la nascita suddetta per avere nella preindicata sua qualità prestati i sussidi dell'arte sua all'atto del parto della dal Cin Antonia di Pietro ed in luogo del di lei marito che trovasi all'estero a scopo di lavoro e fu da me dispensata dal presentarmi il neonato per la troppa distanza dopo essermi altrimenti accertato della verità della nascita.
			audit.creation.date 2021-03-15T20:30:06Z
		}
