	source S1893 {
		title.value deed 15541030 de Benedictis Martinus
		author.text nodaro Semazia Giovanni
		repository.repository R2
		media M2396
		note {
			text busta 884, ultima carta, atto cancellato
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			title Text from source
			text """
1554 : Indictione 12ma Die vero Martis 30mo m[e]n[si]s ottobris in domo
habit[ationis] mei not[ar]ij Infrascripti p[rese]ntibus ser valerio filio q[uondam]
ser donati de menegatis de levatta Silvellar[um] : et Jo[annes] maria
caponi t[es]tibus et[iam]
Ibiq[ue] cu[m] sit q[uod] ser Martinus de benedictis de Scandolaria q[uondam] ser
angeli emisset ab antonio trivisano q[uondam] d[o]m[inic]ij d[e] dicta
villa campu[m] unu[m] ad p[er]tica[m] tar[visinam] v[idelicet] in duab[us] p[a]rtijs in=
tra suos confines p[re]cio ducator[um] ? 23 auri ut de
dicta emptione patet in actis q[uondam] ser Joa[n]nis antonij de
Sermacia not[arij] olim Tar[visij] sub die ut in eo augumen=
tavit ducatos quinq[ue] in tot auro de quib[us] et et finem
fecit et[iam] quem augumentu[m] et[iam] : et no[m]i[n]e benedicti q[uondam]
Trivisani p[ro] quo et[iam]"""
			audit.creation.date 2026-07-05T20:00:47Z
		}
		audit.creation.date 2026-07-05T20:00:47Z
	}

