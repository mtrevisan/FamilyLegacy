	source S2830 {
		title.value deed 15050310 de Vonico Alovisius
		author.text nodaro Nogaredo Jeronimo
		repository.repository R2
		media M3571
		media M3572
		note {
			text busta 315, carta 54v
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			title Text from source
			text """
Eo die et loco : et p[rese]ntib[us] ser Alovisio d[e]
padua causidico ser ambrosio d[e] mangonib[us]
not[arij] et ser Joanne manfrinello? forem?
s[er]to? et al[ijs]
Ibiq[ue] Nobilis vir d[ominus] Alovisius d[e] vonico
fil[ius] no[tarius?] Tar[visinus], d[omi]ni bonsemplanti d[e] vonico
no[m]i[n]e et vice dicti eius patris nec
no[n] no[m]i[n]e et vice Mag[nifi]ci d[omi]ni Alb[er]ti
d[e] vonico eius patruj p[ro] quib[us] p[ro]misit
d[e] rato q[uo] laudabu[n]t : et[iam] al[ite]r et[iam] no[m]i[ne]
locat[or] locavit et ad affictu[m] dedit
ser Antonio q[uondam] trivisani d[e] scandolaria
et ser Angello p[er]aza d[e] s[er]macia q[uondam] ser
melchioris d[e] s[er]macia ambobus simul
principalit[er] et i[n] solidu[m] acceptavit
et stipulavit p[ro] se et suis heredib[us]
una[m] eius possess[ionem] arat[am] arborata[m]
plant[atam] et vitigat[am] et[iam] p[ar]ti[m] prat[ivam]
posit[am] i[n] villa d[e] scandolaria dict[am]
la tera d[e]la Jesia tent[am]?
d[e]lans? p[er] m[er]chasmu[m]? d[e] cazarijs In[tra]
suos c[on]fines p[ro] annis q[ui]nq[ue] p[ro]x[ime]
fut[uris], Inceptis i[n] festo sancti
\
pet[ri] p[ro]x[ime] p[re]t[er]iti q[uo] affit[u] et respo[n]=
sione annis dicti c[on]duct[ores] ambo simul
ut sup[ra] Renunt[iantes]? et ? cu[m] obligat[ione]
et[iam] p[ro]miserunt dare sol[ver]e et c[on]ducere?
dicto pat[ron?]o dictis no[min]ib[us] om[n]i anno
?nati[m] star[ia] vigintiquatuor fr[umen]ti
boni mu[n]di sici : et bene cribelati
v[idelicet] mediet[atem?] ad domu[m] Mag[ist]ri? d[omi]ni
Alb[er]ti et alia[m] mediet[atem?], ad domu[m]
dicti d[omi]ni bonsemplantj It[em] stara
duo blade ab eq[ui]s c[on]duct[ores] ut
sup[ra] et p[ro] honorant[ia] ad fest[u]m sancti
pet[r]i par unu[m] pulor[um] ad fest[u]m om[n]iu[m]
sanctor[um] una[m] ancha[m] ad fest[um] nativit[atis]
una[m] spala[m] d[e] porco justi pond[e]ris ad
carnisprivu[m] una[m] par galinar[um] et[iam]
ad fest[u]m pascat[is] una[m] galina[m] cu[m]
25 ovis et qua[m] possess[ionem] p[ro]mis[er]u[n]t bene
arar[e] seminare t[er]azar[e] fossadare
plant[are] vitigar[e] o[mn]ib[us] eor[um] s?mp?[er]
et pot[erunt] melior[are] q[uam] d[e]terior[are] et[iam]
dict[a] locat[or] p[ro]misit guare[nta?]r usq[ue]
ad dict[a] t? Immo[m] q[ue] o[mn]ia et[iam]"""
			audit.creation.date 2026-09-20T15:42:46Z
		}
		audit.creation.date 2026-09-20T15:42:46Z
	}

