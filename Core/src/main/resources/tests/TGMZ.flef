	media M30 {
		uri C:\mauro\heritage\My Genealogy Projects\Trevisan (Dorato)-Gallinaro-Masutti (Manfrin)-Zaros (Basso)\Photos\places\place river Sile 198412.jpg
		kind image
		description place river Sile 198412
		note {
			title Format
			text jpg
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			title Date
			text DEC 1984
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			text Fiume Sile, palude e fontanasso dal campanile di Sant'Angelo verso ovest - Da allora il paesaggio fluviale ha subito una significativa trasformazione in riva destra (a sinistra della foto). Dapprima si è costruito un parcheggio nel terreno agricolo della parrocchia (mais in primo piano). In seguito è stata realizzata la passeggiata e l'area verde lungo il fiume (Parco del Sile). Ma soprattutto si è costruito in maniera sovradimensionata poco piú a sud dell'area fotografata, fra il fiume e la strada.
			audit.creation.date 2026-10-26T00:00:00Z
		}
		audit.creation.date 2026-10-26T00:00:00Z
	}

