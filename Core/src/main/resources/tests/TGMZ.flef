	source S1493 {
		title.value birth Trevisan Ettore Antonio 19160811
		repository.repository R2
		media M1924
		media M1925
		note {
			title Text from source
			text Il dichiarante mi ha denunciato la nascita suddetta nella sua qualità di ufficiale a ciò delegato dalla direzione di questo Ospitale Civile in cui la Michieletto Maria ha partorito il bambino suddetto, ed in luogo del marito della Michieletto stessa, perché assente dal comune. Lo stesso dichiarante fu da me dispensato dal presentarmi il bambino per ragioni igieniche, essendomi altrimenti accertato della verità della nascita.
			audit.creation.date 2021-03-29T00:00:00Z
		}
		audit.creation.date 2021-03-29T00:00:00Z
	}

