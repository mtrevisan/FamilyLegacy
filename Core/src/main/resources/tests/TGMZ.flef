	source S1136 {
		title.value birth Masutti Pasqua 18860226
		repository.repository R29
		media M1488
		note {
			title Text from source
			text La dichiarante è stata da me dispensata dal presentarmi la bambina suddetta, dopo essermi accertato per dichiarazione verbale dei vicinanti della verità della nascita. E la denunciante mi ha pur dichiarato di aver ratificata la nascita suddetta per avere nella preindicata sua qualità prestati i sussidi dell'arte sua alla Cao vedova Masutti Maria Teresa, al momento del parto, ed in luogo del marito, che prese defunto il primo Ottobre milleottocentottantacinque.
			audit.creation.date 2021-02-21T17:29:00Z
		}
		audit.creation.date 2021-02-21T17:29:00Z
	}

