	event E9752 {
		type marriage
		description civil
		date.value.point {
			value.full_date 24 JUL 1904
			calendar gregorian
		}
		place.place P965
		source {
			source S1304
			locator pag 34, Event: MARR, Date: 24 JUL 1904
			stance supports
			evidence {
				information_type primary
				evidence_type direct
			}
		}
		note {
			text """
No Pau Gigante,
O official do Reg.to [Registramento] int' [interino] Edmond Lempé
Termo de Casamento
Aos vinte e quatro dias do mez de Julho do anno de mil novecentos e quatro as oito horas da manhã na casa das audienças do Juiz Districtal do Districto Accioli Vasconcellos Comarca de Santa Cruz presentes o mesmo Juiz commigo Official do Registro interino e as testemunhas Paulo Josinodos Santos e Giovanni Fassina receberam se em matrimonio civil Bortolo Zaros filho legitimo de Zaros Antonio fallecido e Maria Milanesi natural da Italia e residente no Rio Pau Gigante lavrador com vinte seis annos de idade solteiro, com D.a [Dona] Alfonsa Marangoni filha legitima de Marangoni Giovanni e Pasquina Marangoni com vinte annos de idade solteira profissao serviço domestico natural da Itália e residente no Rio Cavallinho (os quais no mesmo acto declararam ter tido antes do casamento uma filha de nome Maria de 5(?) mezes de idade); que nao sao parentes entre si, nem tem outro impedimento legal que os inhiba de casar se um com outro. Em firmeza do que eu Edmond Lempré Official do Registro interino lavrei este acto que vae per todas assignado e a rogo dos contrahentes assigna Giovanni Zaros por estes nao saberem ler nem escrever.
Antonio Mius(?) da Cunha
Giovanni Zaros
Paulo Josino dos Santos com de 21 anno solteiro rezidente no Pau Gigante
Giovan Fassina de 27 annos de idade solteiro lavorador residente no Rio Treviso"""
			audit.creation.date 2026-10-26T00:00:00Z
		}
		audit.creation.date 2026-10-26T00:00:00Z
	}

