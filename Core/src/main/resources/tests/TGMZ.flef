	source S2028 {
		title.value appraisal Trivisan Agnol 1538
		repository.repository R2
		media M2633
		note {
			text Archivio Estimi
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			title Text from source
			text """
Agnol q[uondam] Marchioro Trivisan ga d[e] p[ro]prio
in dicta villa d[e] Scha[n]dolara un
sedime cu[m] casa d[e] mure e d[e] paia
cu[m] tezza et altre fabriche dove
lui habita d[e] ca[m]po un e mezo v[e]l
c[ir]ca v[idelicet] -- 1 q[ue?]ti 2

Ite[m] In dicta villa ca[m]pi cinq[ue] v[e]l
circa v[idelicet] -- 5 q[ue?]ti --

A fitto da m[agistro] Bastia[n] Belansa campi
desnuove q[ue?]ti Tre v[e]l c[ir]ca In dicta
villa d[e] Schandolara cu[m] cortivo casa
d[e] muro e d[e] coppi Tezze et altre
fabriche p[ar]te de le qual ne
sono de soi miorame[n]ti la qual
Tie[n] p[er] uso suo paga d[e] fitto se?
? vintisie et honora[n]ze d[e] mazo
v[idelicet] -- 19 q[ue?]ti 3

Ite[m] dal dicto m[agistro] Bastia[n] campi do
v[e] c[ir]ca In villa d[e] morga[n] v[idelicet]
paga d[e] fitto for[men]to st[ara] do -- 2 q[ue?]ti --

Ite[m] in dicta villa d[e] morga[n] campi sei
e mezo v[e] c[ir]ca da s[er] Thomase"""
			audit.creation.date 2021-12-19T13:02:25Z
		}
		audit.creation.date 2021-12-19T13:02:25Z
	}

