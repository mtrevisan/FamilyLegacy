	source S1905 {
		title.value deed 15710410 de Trivisanis Pasqua
		author.text nodaro Sermazia Perozzo Cipriano
		repository.repository R2
		media M2411
		media M2412
		note {
			text busta 847, carta 64
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			title Text from source
			text """
1571: Indictione 14ma. Die Martis decimo m[ens]is
aprilis Tar[vis]ij in off[ici]o sanitatis p[rese]ntibus ser
Josepho vince[n]tino q[uondam] ser bernardini d[e] busis, et
ser Antonio Nicolino q[uondam] ser blasijs de morgano
Ambobus habitat[oribus] in villa de Ursinico
Testibus vocatis et rogatis,
Ibiq[ue] D[omin]a Pasqua cognominata pasquina
filia q[uondam] ser hier[oni]mi dicto momo d[e] Trivisanis de
Scandolaria, et uxor ser petri Joppati de dicta
villa Scandolaria p[er] se et suos hæredes de p[rese]ntia
licentia, et consensu dicti ser petri eius mariti
ibi p[rese]ntis volentis et consentientis ac eisdem
uxori suae verbum et scientiam dantis, et
\
et solemnitatibus dicto Instru[men]to venditionis
inserrendis?, et cum promissione et obli=
gatione dictor[um] constituentium dictis no=
minibus simul et In solidum de legitima
defensione dictor[um] subitium et Jurium
suor[um] ipsi emptori seu emptoribus
contra quoscumq[ue] et de evictione
sub Generali ypotheca cenaim?, et
quoru[m]cu[m]q[ue] bonor[um] dictæ fraternæ, et
cuiuslibet ipsor[um] fratru[m] constituentium
in solemni forma : Promittentes dic=
ti fra[tr]es constituentes quicquid Actum
gestum, et procuratum fuerit Necno[n] alie=
natum p[er] suprascriptum suum procura=
torem firmu[m] ratum, et gratum habe=
re sub omnium suor[um] p[rese]ntium, et
futuror[um] obligatione bonor[um]"""
			audit.creation.date 2026-07-06T12:04:55Z
		}
		audit.creation.date 2026-07-06T12:04:55Z
	}

