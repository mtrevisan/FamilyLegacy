	event E3084 {
		type death
		date.value.point {
			value.full_date 10 OCT 2019
			calendar gregorian
		}
		place.place P682
		cause.reason hit by a van as he was crossing the street on the pedestrian crossing on via Orlanda
		note {
			text ore 12:00+01:00
			audit.creation.date 2026-10-26T00:00:00Z
		}
		note {
			text """
He had just left school to throw some garbage bags into the bins on the opposite side of the street, and was crossing at the crosswalk to get his car back and go home for lunch.
He was a member of the volunteer organization "Mons. Odino Spolador" and on the very morning of the accident he had been working at the nursery school "S. Antonio" in Campalto."""
			audit.creation.date 2026-10-26T00:00:00Z
		}
		audit.creation.date 2026-10-26T00:00:00Z
	}

