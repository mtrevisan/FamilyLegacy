	source S1123 {
		title.value birth Chiaradia Maria 18840420
		repository.repository R29
		media M1474
		note {
			title Text from source
			text La dichiarante venne da me dispensata dal presentarmi la suddetta bambina per la lontananza, mi ha denunciata la nascita suddetta per avere nelle preindicate sue qualità, prestati i susidi dell'arte sua alla Chiaradia nata Cordazzo Lucia al momento del parto, ed in luogo del marito, che non ha potuto denunciarla per trovarsi all'Estero.
			audit.creation.date 2021-02-14T20:19:48Z
		}
		audit.creation.date 2021-02-14T20:19:48Z
