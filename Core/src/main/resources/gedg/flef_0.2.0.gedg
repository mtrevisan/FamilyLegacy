// PROTOCOL_VERSION = 0.2.0
// PROTOCOL_DATE = 2026-10-20
// PROTOCOL_DESCRIPTION = Family LEgacy Format - DRAFT Release

// ## Global Validation Rules
// The protocol distinguishes between source assertions, researcher interpretations, evidence assessments,
// hypotheses, conclusions, and research activities. These concepts represent different layers of knowledge
// and MUST NOT be treated as equivalent.
// An IndividualRecord (and likewise a GroupRecord or PlaceRecord) represents the researcher's current conclusion about one
// real-world entity. Source assertions are preserved at the level of the records and citations attached to it.
// Evidence is expressed exclusively through SourceCitation (each citation is one piece of evidence, classified by its
// EvidenceQualifiers). The researcher's judgment about an assertion is expressed through CONFIDENCE; the formal resolution of
// conflicting evidence is expressed through ConclusionRecord.
// - ID values of each record MUST be unique within a file.
// - IDs are local to a file and are not stable across merges; they MUST NOT be used as persistent external keys.
// - Circular citation chains SHOULD be avoided.
// - Place relationship cycles SHOULD be prevented.
// - Identity hypotheses SHOULD be unique per unordered pair.
// - PARENT_ACTIVITY chains of ResearchActivityRecord MUST be acyclic.
// - CONFIDENCE expresses the researcher's current confidence in the assertion represented by the containing structure.
// - SOURCE citations support the assertion represented by the containing structure unless explicitly stated otherwise.
// - References MUST resolve to an existing record.
// - Renaming a record Id requires updating every reference to it, including `flef:<Id>` links in notes.
//
// ## Merge
// When two records are judged to represent the same real-world entity, they are merged:
// - only the surviving record remains; every reference to the absorbed record is redirected to the survivor;
// - the IdentityHypothesisRecord that proposed the merge is deleted;
// - references to deleted records are cascaded (see Deletion);
// - the survivor SHOULD add an AUDIT.UPDATE entry whose COMMENT states the absorbed ID and the evidence that justified the merge.
// Merge is the only operation by which a conclusion leads to the deletion of the records it evaluates.
//
// ## Deletion
// When a record is deleted, references to it are cascaded: entries in repeated fields are removed, optional single fields are cleared,
// records whose required single field referenced the deleted record are deleted, and a ConclusionRecord whose RESOLVES becomes empty
// or whose PREFERRED was removed is deleted.
// A ConclusionRecord replaced by a later conclusion on the same competing records SHOULD be deleted; the new conclusion SHOULD record
// the replaced reasoning in its NARRATIVE or in an AUDIT.UPDATE COMMENT.
//
// ## Instance syntax
// A file is a sequence of blocks. The header is written as `header { … }`; each record is written as
//     <record_kind> <Id> { <assignments> }
// where <record_kind> is an arm name of the Record union (e.g. `place_relationship`) and <Id> is the record identifier, e.g.
//     place_relationship PR1077 {
//       subject.place P1035
//       target.place P354
//       type administrative_part_of
//       audit.creation.date 2026-10-16T09:30:00+02:00
//     }
// - A file is encoded in UTF-8. A byte order mark (BOM) at the start of the file MAY be present and is ignored.
// - Indentation is not significant. A path is separated from its value by one or more spaces or tabs; the value starts at the first
//   non-blank character after the path.
// - A line whose last non-blank character is `{` opens a block for the path that precedes it; a line containing only `}` closes the
//   innermost open block. A single-line value cannot end with `{`; such a value MUST be written as a text block (`"""`).
//   Likewise, a single-line value cannot be exactly `"""`.
// - Ids are case-sensitive, but a file MUST NOT contain two Ids that differ only in case.
// - Record kinds, field names, and enum tokens are case-sensitive and lowercase.
// - Records may appear in any order; references may point to records that appear later in the file.
// - The header block MUST be the first block of the file and MUST appear exactly once.
// Assignments:
// - An assignment is `<path> <value>` and terminates at the end of the line. One assignment per line.
// - A structured value is written as a block: `<path> { <assignments> }`.
// - A dotted path is a shorthand for nested blocks: `a.b.c v` is the same as `a { b { c v } }`. When a path segment names a
//   `oneof` arm, it selects that arm; at most one arm per `oneof` may be assigned.
// - Blocks for the same singular field are merged. A singular leaf field (without `*` or `+`) MUST NOT be assigned more than once
//   in the same record; doing so is an error.
// - Each block or dotted line passing through a repeated field (`*`, `+`) creates a new occurrence of that field. A repeated
//   element with more than one field MUST therefore be written as a block, e.g.
//       audit.update {
//         date 2026-10-17T09:30:00+02:00
//         comment fixed place
//       }
// Values:
// - An `Xref<T>` value is written as the bare Id of a record of kind T. The Id prefix carries no meaning; validators check the
//   kind of the referenced record, not its prefix.
// - A single-line value runs to the end of the line and is trimmed at both ends; an empty or whitespace-only value is invalid.
// - A multi-line value is enclosed in triple quotes (`"""` … `"""`): the opening `"""` is followed by a
//   line break, incidental indentation (up to the closing `"""`) is stripped, and no escape sequences are processed.
// - In an `enum | Text` position, a bare token is an enum member if the protocol version declared in HEADER.PROTOCOL.VERSION
//   defines it; otherwise it is a custom value. Custom values MUST match [a-z0-9_]+ so that they can later be promoted to
//   enum members without rewriting data. Validators SHOULD warn about unknown tokens (especially near-misses of enum members)
//   but MUST accept them. Free prose belongs in DESCRIPTION or NOTE fields, not in TYPE fields.
//
// ## Privacy
// - The effective privacy level of a structure is the most restrictive of: its own PRIVACY, the effective level of the structure
//   that contains it, and the effective level of every IndividualRecord or GroupRecord it references (directly, or for an
//   EventRecord through the EventParticipationRecords that reference it).
// - A nested or dependent structure MAY be more restrictive than what it inherits, never less restrictive.
//   Restriction levels in increasing order: public, restricted, confidential.
// - A PRIVACY whose EXPIRES date has passed no longer contributes to the effective level.
// - A DocumentRecord referenced as PREFERRED_IMAGE inherits the effective level of the IndividualRecord or GroupRecord referencing it.
// - When no PRIVACY applies, the effective level is public, except:
//   - an IndividualRecord that may be living has effective level restricted. An individual may be living unless it is the PRINCIPAL
//     of a DEATH event, or the PRINCIPAL of a BIRTH event dated more than 110 years before the evaluation date. A birth date that is
//     unknown, or in a calendar the implementation cannot convert, does not exclude that the individual is living;
//   - an IndividualAttributeRecord of type NATIONAL_ID has effective level confidential.
// - Contacts in HEADER.SUBMITTER are personal data of a living person: exporters SHOULD omit them from public distributions
//   unless their PRIVACY is public.
//
// ## Preferred assertion
// Some assertion kinds are single-valued: a subject has at most one true assertion of that kind. Competing assertions of these
// kinds are candidates for preferred assertion selection. Single-valued kinds are defined by the protocol version:
// - SEX individual attribute, per individual (TODO).
// - BIRTH and DEATH events, per participant with role PRINCIPAL;
// - BIOLOGICAL_CHILD and CHILD relationships: an individual has at most two biological parents, and a CHILD relationship counts as a
//   possible biological parent. When more than two are asserted, the assertions SHOULD be resolved through ConclusionRecords; while
//   more than two remain after applying them, parentage is undetermined.
// Custom types are not single-valued.
//
// A ConclusionRecord applies to a set of competing records when its RESOLVES contains at least two of them and its PREFERRED is one
// of them. Selection operates on whole records: when the preferred values come from different records, the researcher SHOULD create
// a consolidated record citing the evidence of each, and prefer it.
//
// Consumers that need a single value select it as follows:
// 1. the PREFERRED target of the applicable ConclusionRecord with the strongest PROOF_STATUS (proven, then supported), and among
//    equals the most recent by AUDIT;
// 2. otherwise, the only one, if there is only one;
// 3. otherwise, the one with the strictly highest CONFIDENCE;
// 4. otherwise, the value is undetermined.
//
// Preferred assertion selection affects presentation and convenience features only. It does not alter, remove, invalidate, or
// supersede the underlying assertions unless a merge operation explicitly does so.
//
// ## Compatibility
// - Fields unknown to a reader MUST be preserved unchanged when the file is written back, and MUST NOT be interpreted.
//   References inside unknown fields are not maintained by deletion, merge, or renaming.
// - A reader MUST accept a file whose HEADER.PROTOCOL.VERSION has the same MAJOR version as its own and a higher MINOR or PATCH version.
// - While MAJOR is 0, the MINOR version plays the role of MAJOR: a reader MAY refuse a file with a higher MINOR version.
// - A reader MAY refuse a file with a higher MAJOR version.
// - New MINOR versions only add optional fields, enum members, and record kinds; anything else requires a new MAJOR version.


// ============================================================
// Base scalar types
// ============================================================

alias Text = string
alias Id = string   // record identifier, matching [A-Za-z][A-Za-z0-9_-]*, unique within a file; written as the token after the record kind (e.g. `individual I12 { … }`)
alias DateTime = string   // ISO 8601 date and time with mandatory UTC offset (YYYY-MM-DDThh:mm:ss±hh:mm or YYYY-MM-DDThh:mm:ssZ), as defined by ISO 8601, https://en.wikipedia.org/wiki/ISO_8601
alias HistoricalDate = string   // historical date in the notation of the declared CALENDAR. TODO: notations are not yet normative.
alias Duration = string   // duration, as defined by ISO 8601, https://en.wikipedia.org/wiki/ISO_8601#Durations (e.g. "P2Y")
alias Uri = string   // resource URI, following RFC 3986 specifications, https://datatracker.ietf.org/doc/html/rfc3986
alias LocaleCode = string   // locale identifier; use private-use subtags (x-...) for varieties without a registered code; as defined by IETF BCP 47, https://tools.ietf.org/html/bcp47
alias SemVer = string   // as defined by Semantic Versioning, https://semver.org
alias Coord = string   // geographic coordinates, as defined by ISO 6709, https://en.wikipedia.org/wiki/ISO_6709
alias Int = int


// ============================================================
// File
// ============================================================

file FamilyLegacyFile {
  header: Header
  records*: Record
}

// Top-level record container. Every record type appearing in a file must be represented through this union.
// Every record has an implicit mandatory identifier of type Id, written after the record kind (see Instance syntax).
Record = oneof {
  individual: IndividualRecord
  group: GroupRecord
  event: EventRecord
  individual_attribute: IndividualAttributeRecord
  event_participation: EventParticipationRecord
  group_attribute: GroupAttributeRecord
  relationship: RelationshipRecord
  place: PlaceRecord
  place_relationship: PlaceRelationshipRecord
  repository: RepositoryRecord
  cultural_norm: CulturalNormRecord
  source: SourceRecord
  document: DocumentRecord
  historic_event: HistoricEventRecord
  context_impact: ContextImpactRecord
  identity_hypothesis: IdentityHypothesisRecord
  research_question: ResearchQuestionRecord
  research_activity: ResearchActivityRecord
  research_task: ResearchTaskRecord
  conclusion: ConclusionRecord
}


// ============================================================
// Header
// ============================================================

// metadata
struct Header {
  protocol: struct {
    name: Text        // the name of the protocol; MUST be `FLEF`
    version: SemVer   // the version of the protocol. It is defined and changed by the creators of the product.
  }
  source?: struct {
    name?: Text        // the human-readable name of the software product that produced this file
    version?: SemVer   // the version of the software product. It is defined and changed by the creators of the product.
    organization?: Text   // the name of the organization or person that produced or commissioned the product
  }
  date: DateTime     // the date this file was created
  copyright?: Text   // a copyright statement needed to protect the copyrights of the submitter of this file
  submitter?: struct {
    contact*: ContactStructure   // contact information for the submitter (phone, email, web, etc.)
    remark?: Text                // any notes related to the submitter
  }
  scope?: Text       // a brief description of the file's genealogical scope (e.g., "Ancestors of John Doe")
}


// ============================================================
// Individual
// ============================================================

// primary record
// The researcher's current conclusion about one historical individual, together with the facts, events, relationships, and evidence believed to apply
// to that individual. Two records believed to describe the same individual are candidates for a merge (see IdentityHypothesisRecord and Merge).
record IndividualRecord {
  name*: PersonalNameStructure   // names associated with this individual (birth name, married name, alias, etc.)
  sex?: enum {                   // Biological sex as recorded in sources or inferred from evidence. This represents a genealogical conclusion and may be revised as additional evidence becomes available.
    male, female, unknown
  }
  source*: SourceCitation        // the evidence that this individual existed and, when present, for SEX; facts about the individual are cited on their own records (names, events, attributes, relationships)
  note*: NoteStructure           // free-text notes about this individual
  preferred_image?: struct {
    uri: Uri          // Resource URI pointing to a preferred image of this individual. TODO document: Xref<DocumentRecord>
    crop?: CropRect   // specifies the portion of the image that should be displayed as the preferred representation
  }
  privacy?: PrivacyStructure
  audit: AuditStructure
}

// embedded
// A structured personal name composed of one or more name parts. This structure is intended to support naming systems from all cultures, including given
// names, family names, patronymics, matronymics, clan names, lineage names, titles, and other naming components. The order of PART elements is
// significant and should reflect the historical or culturally appropriate representation of the name.
struct PersonalNameStructure {
  type?: enum {          // https://github.com/FamilySearch/gedcomx/blob/master/specifications/name-part-qualifiers-specification.md
    // marital status and origins at birth
    official, religious, birth,
    // changes in marital status and family events
    married, maiden, divorce, adoption, fostering,
    // legal, immigration, and naturalization changes
    legal, immigrant, adapted,
    // informal, stage, and social names
    alias, nickname, artistic, professional,
    // historical and dynastic contexts
    regnal, slave_name
    // https://github.com/FamilySearch/gedcomx/blob/master/specifications/name-part-qualifiers-specification.md
  } | Text
  part+: NamePartStructure   // The order of PART elements is significant and reflects the culturally appropriate representation of the full name (e.g., 'given' then 'family' for Western names, 'family' then 'given' for East Asian names). No semantic ordering is implied by the individual part types. Consumers must preserve the original order.
  locale?: LocaleCode
  valid_from?: DateStructure    // The date from which this name is known or believed to have been used by the individual.
  valid_to?: DateStructure      // The date until which this name is known or believed to have been used by the individual.
  cultural_norm*: Xref<CulturalNormRecord>   // Unlike ContextImpactRecord, CULTURAL_NORM here describes the naming system that governs the structure of the name itself.
  source*: SourceCitation
  note*: NoteStructure
}

// embedded
struct NamePartStructure {
  type: enum {
    // personal and birth names
    given, generation,
    // direct family relationships (descent)
    patronymic, matronymic, kunya,   // kunya: كُنيَة, Arabic teknonym (e.g. "Abu ...", "Umm ...")
    // extended family and social belonging
    family, family_nickname, lineage, house, clan, tribal, caste,
    // geographical and territorial origin
    toponymic,
    // titles, roles and professions
    title, occupational, prefix, suffix,
    // assumed names, nicknames and contextual
    nickname, regnal, religious, posthumous
  } | Text
  value: Text                  // the textual value of this individual name component
  variant*: TextValueVariant   // alternative phonetic, transliterated, or transcribed representations of this name component
}


// ============================================================
// Event
// ============================================================

// primary record
// Represents the occurrence of a historical action, ceremony, condition, transaction, legal process, or other happening. An EVENT describes what
// happened. Persistent associations resulting from an event SHOULD be represented separately using RELATIONSHIP records.
record EventRecord {
  type: enum {                    // The type of event. Custom types are permitted.
    // life
    birth, adoption, death, cremation, burial, coroner_report, illness, hospitalization, medical_procedure,
    // family
    engagement, marriage_bann, marriage_contract, marriage_license, marriage_settlement, marriage, divorce_filed, divorce_decree, divorce, annulment,
    // achievements
    education, graduation, retirement, military_induction, military_muster_roll, military_service, military_award, military_release, military_discharge, military_resignation, military_retirement, prison, pardon, jury_duty, honor, bankruptcy,
    // national / government
    immigration, naturalization, emigration, deportation, internment, liberation, emancipation, relocation, census,
    // possessions and titles
    deed, escrow, chancery, will, probate, guardianship
  } | Text
  description?: Text              // Human-readable description of the event when a structured representation is insufficient.
  date?: DateStructure            // the date of the event
  place?: PlaceCitation           // the location of the event
  cause?: struct {
    reason: Text              // used in special cases to record the reasons which precipitated an event, e.g. cause of death subordinate to a death event
    source*: SourceCitation   // the evidence that this was the cause
    confidence?: Confidence   // confidence that this was the cause
  }
  source*: SourceCitation         // the evidence that this event happened
  note*: NoteStructure
  confidence?: Confidence         // confidence that this event happened
  privacy?: PrivacyStructure
  audit: AuditStructure
}

// --- Informational note: taxonomy of EVENT/ATTRIBUTE types ---
// Sources: https://wiki.phpgedview.net/en/index.php/Facts_and_Events
//          http://www.gencom.org.nz/GEDCOM_tags.html
//
// Life related types are: BIRTH (the exiting of the womb), ADOPTION (the creation of a parent-child relationship not associated with birth), CHARACTERISTIC
// (physical characteristics of a person, in the format `key1: value1, key2: value2`), DEATH (the end of life), CHILDREN_COUNT (the reported number of
// children associated with a family or household group, regardless of whether the associated children are represented in the corresponding structure; this
// is not necessarily the count of children listed in a group structure), MARRIAGES_COUNT, CORONER_REPORT (the act of including an individual in a
// report by a coroner, a public official, on the investigation into the causes and circumstances of any death which occurred through violence or suddenly
// with marks of suspicion), BURIAL (the depositing of the body (in whole or in part) of the deceased), CREMATION (the burning of the body (in whole or in
// part) of the deceased).
// Family related types are: ENGAGEMENT (the agreement of a couple to enter into a marriage in the future), MARRIAGE_BANN (a public notice of an intent to
// marry), MARRIAGE_CONTRACT (a formal contractual agreement to marry), MARRIAGE_LICENSE (obtaining a legal license to marry), MARRIAGE_SETTLEMENT (a
// legal arrangement to modify property rights upon marriage), MARRIAGE (the creation of a family unit via a legal, religious, customary, common-law, or
// other form of union), DIVORCE_FILED (the legal action expressing intent to divorce), DIVORCE_DECREE (an individual's participation in a decree of a
// court marking the legal separation of a man and woman, totally dissolving the marriage relation), DIVORCE (the ending of a marriage between still-living
// individuals), ANNULMENT (declaring a marriage to be invalid, as though it had never occurred).
// Achievements related types are: RESIDENCE, EDUCATION (an educational degree or attainment), GRADUATION (the conclusion of formal education), OCCUPATION
// (what this person does as a livelihood), RETIREMENT (the cessation of gainful employment, typically because sufficient wealth has been accumulated
// to no longer necessitate such), MILITARY_AWARD, MILITARY_DISCHARGE, MILITARY_INDUCTION, MILITARY_MUSTER_ROLL, MILITARY_SERVICE, MILITARY_RANK,
// MILITARY_RELEASE, MILITARY_RESIGNATION, MILITARY_RETIREMENT, PRISON (the act of punishment imposed by law or otherwise in the course of administration of
// justice), PARDON, MEMBERSHIP, JURY_DUTY, MEDICAL, HOSPITALIZATION, ILLNESS, HONOR, LIBERATION (the liberation of the Holocaust survivor from place of
// internment), DEPORTATION, INTERNMENT, EMANCIPATION (the emancipation of a minor child by its parents, involving the entire surrender of the right to
// care, custody, and earnings of such child), BANKRUPTCY.
// National/government related types are: CASTE (the social, religious, or racial caste to which an individual belongs), ETHNICITY (an ethnic, tribal,
// cultural, or ancestral group with which a person is associated), CITIZENSHIP (the legal nationality or citizenship status held by a person within a state,
// nation, or political entity), EMIGRATION, IMMIGRATION, NATURALIZATION, CENSUS, NATIONAL_ID.
// Possessions and titles related types are: POSSESSION (a list of objects or land owned by the person), TITLE (a title associated with a local or
// national notion of nobility or royalty), WILL (the creation of a legal document regarding the disposition of a person's estate upon death), PROBATE
// (the judicial actions associated with the disposition of the estate of the deceased), DEED (the judicial actions associated with the transferring of
// title to a property), GUARDIANSHIP (the act of legally appointing an individual to take care of the affairs of someone who is young or cannot
// take care of her/himself), ESCROW, CHANCERY (the resolution through impartial justice between two parties whose claims conflict).
// Religious and social related types are: RELIGION (the name of a religion with which the event was affiliated).
// Custom type: a token matching [a-z0-9_]+ (see Instance syntax).


// ============================================================
// Individual attribute
// ============================================================

// entity-owned record
// A characteristic, condition, status, classification, or descriptive property attributed to an individual. Attributes may be directly recorded
// in sources, derived from evidence, inferred from research, or reported through oral tradition.
// Individual attributes describe enduring or observable characteristics of a person rather than discrete events. Events such as birth,
// marriage, military service, education, immigration, or death SHOULD normally be represented using EVENT records.
record IndividualAttributeRecord {
  individual: Xref<IndividualRecord>   // The individual to whom this attribute applies.
  type: enum {                         // The type of attribute being asserted.
    characteristic,    // Physical, behavioral, medical, or descriptive characteristic (e.g "blue eyes", "blind", "left-handed", "scar on forehead").
    residence,         // Place where the individual is known to have lived, resided, or maintained a household.
    occupation,        // Occupation, profession, trade, office, or vocation (e.g. "farmer", "blacksmith", "teacher").
    possession,        // Property, assets, land, livestock, tools, money, or other possessions associated with the individual.
    military_rank,     // Military rank or grade held by the individual (e.g. "captain", "sergeant", "colonel").
    caste,             // Social, hereditary, religious, or legal caste classification associated with the individual.
    social_class,      // Social, economic, or societal classification associated with the individual (e.g. "nobility", "bourgeoisie", "peasant").
    ethnicity,         // Ethnic, tribal, cultural, or ancestral identity.
    citizenship,       // Citizenship, nationality, or legal political allegiance.
    nationality,       // National identity, ethnic-national affiliation, or nationality associated with the individual. Unlike CITIZENSHIP, nationality may reflect cultural or historical identity rather than legal status.
    national_id,       // Government-issued personal identification number (e.g. Social Security Number, Tax Code, National ID).
    title,             // Noble, honorific, professional, hereditary, religious, or administrative title associated with the individual (e.g. "Count", "Doctor", "Bishop", "Sir").
    children_count,    // Reported number of children associated with the individual.
    marriages_count,   // Reported number of marriages associated with the individual.
    religion,          // Religion, denomination, faith, or spiritual affiliation.
    language,          // Language spoken, written, understood, or otherwise associated with the individual.
    literacy,          // Ability to read and/or write (e.g. "illiterate", "literate", "signature only").
    education          // Educational attainment, schooling level, degree, qualification, or academic status (e.g. "elementary", "secondary", "university", "doctorate").
  } | Text
  value?: Text                         // The value of the attribute. When the value is a place (e.g. RESIDENCE), it is given by PLACE and VALUE MAY only add details not represented by the place record (e.g. "with his uncle", "as a servant").
  valid_from?: DateStructure           // The date from which this attribute is known or believed to have been valid.
  valid_to?: DateStructure             // The date until which this attribute is known or believed to have been valid.
  place?: PlaceCitation                // Place specifically associated with this attribute; for RESIDENCE, the place of residence.
  source*: SourceCitation              // Sources supporting this attribute.
  note*: NoteStructure
  confidence?: Confidence              // confidence that this attribute was true
  privacy?: PrivacyStructure
  audit: AuditStructure
}


// ============================================================
// Event participation
// ============================================================

// association record
// Associates an entity with an event and, when known, describes the role played by the entity within that event. All participation in events SHALL
// be represented through EVENT_PARTICIPATION records. This design allows the same event to have multiple participants (e.g., a marriage has two
// principals) and the same entity to participate in multiple events (e.g., a person can be born, married, and buried).
// Implementations SHOULD validate participant types according to the EVENT type when such constraints are known.
// A place participant MUST have role PROPERTY (or a custom role); individual and group participants MUST NOT use PROPERTY.
record EventParticipationRecord {
  participant: EventParticipant   // may reference any record type capable of participating in an event, including individuals, groups, or future extensible entities
  event: Xref<EventRecord>        // the event in which the entity participated
  role?: enum {                   // the function of the participant in the event; roles never express kinship (see RelationshipRecord)
    principal,          // the participant the event is about (the person born, baptized, buried; each of the persons married or divorced)
    officiant,          // the person who performed or administered the event (priest, registrar, notary)
    witness,            // a person who witnessed the event
    informant,          // a person who reported the event (e.g. the declarant of a birth or death)
    sponsor,            // godparent or sponsor (baptism, confirmation)
    power_of_attorney, prisoner, executor, grantor, grantee, landlord, tenant, soldier, commander, victim, survivor, accused, judge,
    property            // the place that is the object of the event (participant MUST be a place)
  } | Text
  source*: SourceCitation   // the evidence that this participation was true
  note*: NoteStructure
  confidence?: Confidence   // confidence that this participation was true
  privacy?: PrivacyStructure
  audit: AuditStructure
}

EventParticipant = oneof {
  individual: Xref<IndividualRecord>
  group: Xref<GroupRecord>
  place: Xref<PlaceRecord>   // a place that is the object of the event (e.g. the land conveyed by a deed), not where it happened; use EventRecord.PLACE for the location
}


// ============================================================
// Group
// ============================================================

// primary record
// A group of genealogical entities. A group can be a family, a household, a neighborhood, a club, a research group, etc.
// Membership in a GROUP is determined exclusively through RelationshipRecords whose TARGET references the GROUP and whose TYPE is
// GROUP_MEMBER; GroupRecord does not contain a member list, so that membership has its own dates, sources, and confidence.
// Membership in a GROUP does not by itself assert any kinship. Kinship and marriage are expressed only through RelationshipRecords
// between individuals (BIOLOGICAL_CHILD, ADOPTIVE_CHILD, CIVIL_SPOUSE, ...). Consumers MUST NOT infer parent-child or spouse
// relationships from group membership or its roles.
record GroupRecord {
  name*: NameStructure      // names associated with the group. Different names may represent historical, official, customary, translated, abbreviated, or otherwise variant forms used at different times or in different contexts.
  type?: enum {
    family, household, neighborhood, fraternity, club, literary_society, association, organization, tribe
  } | Text
  source*: SourceCitation   // the evidence that this group existed; facts about the group are cited on their own records (attributes, relationships, events)
  note*: NoteStructure
  preferred_image?: struct {
    uri: Uri          // Resource URI pointing to a preferred image of this group. TODO document: Xref<DocumentRecord>
    crop?: CropRect   // specifies the portion of the image that should be displayed as the preferred representation
  }
  privacy?: PrivacyStructure
  audit: AuditStructure
}


// ============================================================
// Group attribute
// ============================================================

// entity-owned record
// A characteristic, condition, status, classification, or descriptive property attributed to a group. Attributes may be directly recorded in
// sources, derived from evidence, inferred from research, or reported through oral tradition.
// Group attributes describe the group itself as a collective entity rather than the individual members who compose it. Events that occur at a specific
// point in time (such as founding, migration, merger, or dissolution) SHOULD be represented using EVENT records instead.
record GroupAttributeRecord {
  group: Xref<GroupRecord>        // The group to which this attribute applies.
  type: enum {                    // The type of attribute being asserted.
    residence,              // Place where the group is known to reside or be established.
    member_count,           // Reported number of group members. This value represents a source assertion and may differ from the number of members explicitly represented in the file.
    children_count,         // Reported number of children associated with the group. This value represents a source assertion and may differ from the number of child members explicitly represented in the file
    social_class,           // Economic or social classification of the group (e.g. "peasant", "middle_class", "nobility").
    ethnicity,              // Ethnic, tribal, cultural, or ancestral identity associated with the group as a whole.
    religion,               // Religion practiced or associated with the group.
    language,               // Language primarily spoken or associated with the group.
    wealth,                 // Description of the group's wealth, economic standing, or reported financial condition.
    land_holding,           // Description or quantity of land owned, occupied, or controlled by the group.
    primary_income_source   // Principal economic activity or source of income associated with the group.
  } | Text
  value?: Text                    // The value of the attribute. When the value is a place (e.g. RESIDENCE), it is given by PLACE and VALUE MAY only add details not represented by the place record.
  valid_from?: DateStructure      // The date from which this attribute is known or believed to have been valid.
  valid_to?: DateStructure        // The date until which this attribute is known or believed to have been valid.
  place?: PlaceCitation           // Place specifically associated with this attribute; for RESIDENCE, the place of residence.
  source*: SourceCitation         // the evidence that this attribute was true
  note*: NoteStructure
  confidence?: Confidence         // confidence that this attribute was true
  privacy?: PrivacyStructure
  audit: AuditStructure
}


// ============================================================
// Naming (generic, non-personal) and text values
// ============================================================

// embedded
// A textual designation associated with an entity, source, place, organization, repository, group, or other object.
// This structure represents a complete textual expression and may be used for names, titles, labels, or similar identifying text.
// Unlike PersonalNameStructure, this structure does not decompose the text into culturally-specific components such as given names, family names,
// patronymics, titles, or lineage elements.
struct NameStructure {
  type?: enum {
    // official and legal names
    official,         // officially recognized name used by a government, institution,
    legal,            // name defined by law, regulation, charter, or legal act
    // historical naming traditions
    colonial,         // name introduced or imposed during a colonial period
    indigenous,       // name originating from the local or native population
    traditional,      // name established through long-standing customary use
    // language and localization variants
    translated,       // name translated into another language
    transcribed,      // name transliterated or transcribed into another writing system
    // historical variants
    historic,         // historical name used during a specific period
    // common usage
    common,           // commonly used name regardless of official status
    colloquial,       // informal or popular name used in everyday speech
    // abbreviated forms
    abbreviated,      // shortened form of a name
    acronym,          // name formed from initials or abbreviations
    // religious and ecclesiastical forms
    religious,        // name used in a religious, ecclesiastical, or liturgical context
    // administrative and archival forms
    administrative,   // name used by an administrative authority
    archival          // name appearing in archival, documentary, or cataloging contexts
  } | Text
  value: Text                   // the primary textual value
  locale?: LocaleCode
  variant*: TextValueVariant    // alternative phonetic, transliterated, or transcribed representations
  valid_from?: DateStructure    // The date from which this name is known or believed to have been valid.
  valid_to?: DateStructure      // The date until which this name is known or believed to have been valid.
  cultural_norm*: Xref<CulturalNormRecord>   // Unlike ContextImpactRecord, CULTURAL_NORM here describes the naming system that governs the structure of the name itself.
  source*: SourceCitation
  note*: NoteStructure
}

// embedded
// Alternative written, phonetic, transliterated, or transcribed representations of the same textual value. These representations do not constitute separate
// names; they are alternate renderings of the same name.
TextValueVariant = oneof {
  phonetic: struct {
    system: Text   // usually IPA, but other systems can be used (e.g., canIPA)
    value: Text    // phonetic/phonematic component
  }
  transcription: struct {
    system: enum {   // indicates the system used to transcribe the text to the transcribed variation
      romaji, hepburn, kunreishiki, nihonshiki,   // Japanese
      pinyin, wadegiles,                          // Chinese
      bgn_pcgn,                                   // various geographic standards
      iso9,                                       // Cyrillic -> Latin
      ala_lc,                                     // Library of Congress
      dmg,                                        // Arabic/Persian scholarly
      buckwalter,                                 // Arabic
      iso233,                                     // Arabic
      iso259,                                     // Hebrew
      iast,                                       // Sanskrit
      iso15919, hunterian,                        // Indic scripts
      mccune_reischauer, revised_korean,          // Korean
      scientific                                  // generic scholarly transliteration
    } | Text
    type?: enum {
      romanized,      // converted to Latin script
      latinized,      // converted to Latinized scholarly form
      anglicized,     // adapted to English
      francized,      // adapted to French
      germanized,     // adapted to German
      italianized,    // adapted to Italian
      hispanicized,   // adapted to Spanish
      lusitanized,    // adapted to Portuguese
      cyrillized,     // converted to Cyrillic
      arabized,       // converted to Arabic script
      hebraized,      // converted to Hebrew script
      hellenized,     // converted to Greek script
      gairaigized,    // adapted to Japanese loanword form
      modernized,     // historic spelling modernized
      normalized      // orthography normalized
    } | Text
    value: Text      // transcribed component
  }
}


// ============================================================
// Relationship
// ============================================================

// association record
// Represents an enduring association between genealogical entities. A RELATIONSHIP describes a state, connection, or affiliation that may exist
// before, during, or after one or more events. Events that create, modify, recognize, or terminate a relationship SHOULD be represented separately
// using EVENT records. This separation allows relationships to exist independently of events (e.g., a biological parent-child relationship
// exists regardless of whether a birth event is documented).
// Implementations SHOULD validate the allowed SUBJECT and TARGET types according to the relationship TYPE.
// TYPE is a closed list: relationships not listed here are expressed as ASSOCIATE with a ROLE (e.g. godparent, servant, business_partner).
// CHILD and SPOUSE are used when the evidence does not state the nature of the relationship; they SHOULD be replaced by the specific
// type when it becomes known.
record RelationshipRecord {
  subject: RelationshipParticipant   // The entity for which the relationship is being asserted. The SUBJECT is always the entity whose role is described by TYPE and ROLE relative to the TARGET. Example: `biological_child(Alice -> John)` means that Alice is the biological child of John.
  target: RelationshipParticipant    // the entity to which the subject is related to
  type: enum {
    child,                // (Individual -> Individual) parent-child relationship whose nature (biological, adoptive, ...) is not stated by the evidence
    biological_child,     // (Individual -> Individual) relationship exists through birth
    adoptive_child,       // (Individual -> Individual) relationship created through legal adoption
    foster_child,         // (Individual -> Individual) temporary foster-care relationship
    guarded_child,        // (Individual -> Individual) court-appointed legal guardianship relationship
    step_child,           // (Individual -> Individual) relationship created through marriage and not through descent
    spouse,               // (Individual -> Individual) marriage whose form (civil, religious, customary) is not stated by the evidence
    civil_spouse,         // (Individual -> Individual) marriage recognized by civil authority
    religious_spouse,     // (Individual -> Individual) marriage recognized by religious authority
    customary_spouse,     // (Individual -> Individual) marriage recognized by local custom or tradition
    cohabiting_partner,   // (Individual -> Individual) non-marital domestic partnership
    engaged_partner,      // (Individual -> Individual) promise or agreement to marry
    group_member,         // (Individual -> Group) membership of an individual in a group
    associate,            // (Individual -> Individual | Individual -> Group | Group -> Group) general association
    part_of               // (Group -> Group) membership of a group within a larger group
  }
  role?: Text                        // the function, position, capacity or responsibility held by the SUBJECT relative to the TARGET. This field provides additional contextual, organizational, legal, social, or cultural interpretation that is not fully expressed by TYPE alone. ROLE supplements TYPE and SHOULD NOT contradict it. Implementations SHOULD verify that ROLE is semantically compatible with TYPE (ex. biological_child/adoptive_child/foster_child/guarded_child/step_child/civil_spouse/religious_spouse/customary_spouse/cohabiting_partner/engaged_partner/part_of -> ROLE is normally unnecessary and SHOULD be omitted, group_member -> examples include member, president, secretary, treasurer, resident, head_of_household, tribal_leader, elder, custodian, ..., associate -> any role MAY be supplied because the relationship itself is generic).
  valid_from?: DateStructure         // the date from which this relationship was known to be in effect
  valid_to?: DateStructure           // the date until which this relationship was known to be in effect
  source*: SourceCitation            // the evidence that this relationship was true
  note*: NoteStructure
  confidence?: Confidence            // confidence that this relationship was true
  privacy?: PrivacyStructure
  audit: AuditStructure
}

RelationshipParticipant = oneof {
  individual: Xref<IndividualRecord>
  group: Xref<GroupRecord>
}


// ============================================================
// Place
// ============================================================

// primary record
// A geographical, administrative, ecclesiastical, cadastral, historical, or physical location. Places may be linked together using PLACE_RELATIONSHIP
// records in order to model changing jurisdictions and historical geography.
// A PlaceRecord follows the identity of a place, not its name: a change of name alone is recorded as an additional dated NAME of the
// same record. TYPE is fixed for the lifetime of the record: a change of type or administrative status (e.g. a hamlet becoming a
// municipality, a chapelry becoming a parish) creates a new PlaceRecord linked to the previous one by SUCCESSOR_OF. Separate
// PlaceRecords linked by PlaceRelationshipRecords are also used when the identity of the place changes (e.g. merger, division,
// suppression).
// A place that returns to a previous status is a new PlaceRecord; earlier records are not reused, so that succession chains stay acyclic.
record PlaceRecord {
  name+: NameStructure      // the name of the place formatted for display and address generation
  type?: enum {
    // settlements and built environments
    address,             // specific postal or civic address
    building,            // individual building or structure
    street,              // street, road, avenue, lane, or similar thoroughfare
    hamlet,              // very small settlement, usually smaller than a village
    village,             // small rural settlement
    town,                // populated settlement larger than a village
    municipality,        // local administrative unit with self-government
    city,                // major urban settlement
    metropolitan_area,   // urban area consisting of a central city and surrounding communities
    // administrative jurisdictions
    county,              // county-level administrative division
    province,            // province-level administrative division
    department,          // department-level administrative division
    district,            // district-level administrative division
    region,              // region-level administrative division
    macro_region,        // supra-regional grouping of multiple regions
    country,             // sovereign state or nation
    empire,              // multi-ethnic or multi-national imperial state
    // ecclesiastical jurisdictions
    parish,              // ecclesiastical parish
    archdiocese,         // ecclesiastical province headed by a metropolitan archbishop
    diocese,             // ecclesiastical diocese or equivalent jurisdiction
    // sites and institutions
    cemetery             // burial ground or cemetery
  } | Text
  location?: struct {       // Contains a representative geographic location for the place.
    coordinates: Coord        // geographic coordinates of the place, representative point, not necessarily the full territorial extent of the place
    source*: SourceCitation   // the evidence that this location was true for the place
    confidence?: Confidence   // confidence that this location was true for the place
  }
  source*: SourceCitation   // the evidence that this place really existed
  note*: NoteStructure
  confidence?: Confidence   // confidence that this place really existed
  privacy?: PrivacyStructure
  audit: AuditStructure
}

// embedded
// Reference to a PLACE record together with location-specific citations.
// Implementations SHOULD prevent cyclic expansion of citation metadata (PlaceCitation > SourceCitation > SourceRecord > PlaceCitation).
struct PlaceCitation {
  place: Xref<PlaceRecord>
  original_text?: Text      // The place name exactly as recorded in the source. This value MAY coexist with PLACE when the source wording is preserved alongside a normalized place identification.
  source*: SourceCitation   // the evidence that this place is really the one cited
  confidence?: Confidence   // confidence that this place is really the one cited
}

// association record
// A relationship connecting two place records. Place relationships are used to represent geographic, administrative, ecclesiastical, judicial,
// cadastral, postal, or historical associations between places. These relationships may change over time and can therefore be bounded by
// validity dates.
// For each relationship type, implementations SHOULD prevent cycles. Cycle validation SHOULD take validity dates into account when present.
// Relationships are directional: `administrative_part_of(Treviso -> Veneto)` is NOT equivalent to `administrative_part_of(Veneto -> Treviso)`.
// For succession types (SUCCESSOR_OF, MERGED_FROM, SPLIT_FROM, RECEIVED_TERRITORY_FROM) the SUBJECT is always the later place.
// MERGED_FROM and SPLIT_FROM imply succession: SUCCESSOR_OF MUST NOT be asserted between the same pair of places.
record PlaceRelationshipRecord {
  subject: struct {
    place: Xref<PlaceRecord>   // the place for which the relationship is asserted. The SUBJECT is always the place whose role is described by TYPE relative to the TARGET.
  }
  target: struct {
    place: Xref<PlaceRecord>   // the place to which the subject is related
  }
  type: enum {
    administrative_part_of,    // subject is part of an administrative jurisdiction, e.g., Treviso → Veneto
    geographic_part_of,        // subject is geographically contained within another place
    ecclesiastical_part_of,    // subject belongs to an ecclesiastical jurisdiction such as a parish, diocese, or archdiocese
    judicial_part_of,          // subject belongs to a court, district, or judicial jurisdiction
    cadastral_part_of,         // subject belongs to a cadastral or land-records district
    successor_of,              // subject replaced or inherited the identity or function of the TARGET place, other than by merger or division
    merged_from,               // subject was created, wholly or partially, by the merger of the TARGET place (one record per merged place)
    split_from,                // subject was created from the division of the TARGET place
    received_territory_from    // subject received part or all of the territory of the TARGET place, which continued to exist
  } | Text
  valid_from?: DateStructure   // the date from which this place relationship is known or believed to have been valid
  valid_to?: DateStructure     // the date until which this place relationship is known or believed to have been valid
  source*: SourceCitation      // the evidence that this place relationship was true, including its interpretation and dating
  note*: NoteStructure         // a note containing commentary, interpretation, or discussion related to this place relationship
  confidence?: Confidence      // confidence that this place relationship was true
  audit: AuditStructure
}


// ============================================================
// Note
// ============================================================

// embedded
struct NoteStructure {
  title?: Text   // note title
  text: Text     // comments or opinions from the submitter. In markdown or HTML notes, references to records in this file are written as links to the URI `flef:<Id>` (e.g. `[Giovanni](flef:I12)`), and text that SHOULD be hidden when confidential information is suppressed is written as a link to `flef:confidential` (e.g. `[born at home](flef:confidential)`).
  mime?: Text    // media type of TEXT and of its translations: text/plain (default), text/markdown, text/html, etc.
  locale?: LocaleCode
  translation*: struct {
    text: Text   // a translated version of the note
    locale?: LocaleCode
  }
  source*: SourceCitation
  privacy?: PrivacyStructure
  audit: AuditStructure
}


// ============================================================
// Repository
// ============================================================

// primary record
// A representation of where a source or set of sources is located. May be formal, like a library, or informal, like the owner of a family book.
record RepositoryRecord {
  name+: NameStructure                 // the official name of the archive in which the stated source material is stored
  custodian?: Agent                    // the current custodian of the repository or of its material
  place?: PlaceCitation                // the location of the repository
  contact*: ContactStructure
  note*: NoteStructure
  privacy?: PrivacyStructure
  audit: AuditStructure
}

// embedded
// Citation of a repository holding a source or source collection. Allows recording repository-specific shelf marks, page references,
// entry identifiers, or other retrieval information.
struct RepositoryCitation {
  repository: Xref<RepositoryRecord>
  locator?: Text   // location of the referenced material inside the repository (e.g., 'Shelf Mark: 12, Film: 1234567, Frame: 344, Line: 28', or 'Volume: 2, Page: 143, Entry: 17', or 'folio', 'image', etc.)
  remark*: Text    // short free-text remark about this repository citation
}


// ============================================================
// Contact
// ============================================================

// embedded
// Machine-readable contact information for a person, organization, repository, submitter, or other entity.
struct ContactStructure {
  value: Text   // a phone number, an electronic address such as an email (RFC 5322), a web page address (RFC 3986), or any other type of contact address
  type?: enum {
    email,      // Email address.
    phone,      // Voice telephone number.
    mobile,     // Mobile telephone number.
    fax,        // Fax number.
    website,    // Website or homepage.
    blog,       // Blog or personal publication site.
    social,     // Social media profile or account.
    postal,     // Postal or physical address.
    messaging   // Messaging application endpoint (e.g. WhatsApp, Signal, Telegram).
  } | Text
  name?: struct {
    value: Text                  // the name of the person associated with this contact
    variant*: TextValueVariant   // alternative phonetic, transliterated, or transcribed representations
  }
  remark?: Text
  privacy?: PrivacyStructure
  audit: AuditStructure
}


// ============================================================
// Cultural norm
// ============================================================

// primary record
// Genealogical events and individual characteristics at various times and places are influenced by customs, practices, and conditions of their
// culture. This affects the interpretation of recorded information and the assumptions made about probable genealogical events when there is no or
// little known information. For example, a birth year can be estimated by knowing the date of a religious ceremony which normally involves a child
// of 12 years old.
record CulturalNormRecord {
  title?: Text                 // the title of the rule
  type?: enum {           // Broad category of cultural rule. Detailed interpretation and parameters are expressed through notes, citations, and external documentation.
    // lifecycle and age-related customs
    age_of_majority, marriage_minimum_age, baptism_age, confirmation_age, military_service_age, retirement_age,
    // naming practices
    naming_convention, surname_transmission, patronymic_system, matronymic_system, title_usage,
    // family and household customs
    inheritance_rule, succession_rule, dowry_practice, guardianship_rule, adoption_practice,
    // marriage customs
    marriage_practice, marriage_prohibited_degree, widowhood_rule,
    // residence and social organization
    residence_pattern, household_structure, social_classification,
    // religious and ecclesiastical customs
    religious_practice, burial_practice,
    // legal and citizenship rules
    citizenship_rule, legitimacy_rule,
    // genealogical inference rules
    age_difference_convention, generational_interval
  } | Text
  place?: PlaceCitation        // the location in which this cultural norm was in effect
  valid_from?: DateStructure   // the date from which this cultural norm was in effect
  valid_to?: DateStructure     // the date until which this cultural norm was in effect
  note*: NoteStructure
  source*: SourceCitation      // the evidence that this cultural norm was true
  confidence?: Confidence      // confidence that this cultural norm was true
  audit: AuditStructure
}

// association record
// Links a contextual factor to a genealogical entity, assertion, or research outcome that it influences, explains, constrains, motivates, or causes.
// Contextual factors may include cultural norms, historical events, legal frameworks, social customs, environmental conditions, or other external influences represented
// through CONTEXT.
// This record is intended to document interpretative relationships rather than direct evidence of participation or ownership. It explicitly captures how broader context
// helps explain, influence, or justify genealogical conclusions and assertions.
//
// Recommended usage:
//  - Historic events commonly EXPLAIN, INFLUENCE, MOTIVATE or CAUSE.
//  - Cultural norms commonly EXPLAIN, INFLUENCE or CONSTRAIN.
// Implementations SHOULD warn when a combination appears semantically unusual.
// Implementations SHOULD index ContextImpactRecord by both CONTEXT and TARGET.
record ContextImpactRecord {
  context: ContextSource    // The contextual factor exerting the influence.
  target: ImpactTarget      // The entity, assertion, attribute, relationship, or conclusion affected by the context.
  impact_type?: enum {
    explains,     // Provides explanatory context for the target.
    influences,   // Exerts a general influence on the target.
    constrains,   // Limits or restricts what was possible or likely.
    motivates,    // Encourages, promotes, or makes the target more likely.
    causes        // Directly contributes to the occurrence or existence of the target.
  } | Text
  rationale?: Text          // Explanation of how and why the contextual factor influences, explains, constrains, motivates, or causes the target.
  source*: SourceCitation   // the evidence that this context impact was true
  confidence?: Confidence   // confidence that this context impact was true
  audit: AuditStructure
}

// A contextual factor that may influence or explain genealogical information.
// Context sources are not themselves evidence that a target participated in an event or followed a practice; they provide historical, cultural, legal, social,
// environmental, or interpretative context.
ContextSource = oneof {
  cultural_norm: Xref<CulturalNormRecord>
  historic_event: Xref<HistoricEventRecord>
}

ImpactTarget = oneof {
  individual: Xref<IndividualRecord>
  group: Xref<GroupRecord>
  place: Xref<PlaceRecord>
  event: Xref<EventRecord>
  relationship: Xref<RelationshipRecord>
  individual_attribute: Xref<IndividualAttributeRecord>
  group_attribute: Xref<GroupAttributeRecord>
  conclusion: Xref<ConclusionRecord>
  event_participation: Xref<EventParticipationRecord>
  place_relationship: Xref<PlaceRelationshipRecord>
  identity_hypothesis: Xref<IdentityHypothesisRecord>
}


// --- Examples ---
// For Latin names, you must use the nominative (which generally ends in -us for men and -a for women).
// Napoleonic Code age of majority (31 JAN 1807 - dates below):
//   men: 23 years minor, 29 years major (31 JAN 1807 - 19 FEB 1811) (25, respectful act however until 30)
//   women: 22 years minor (31 JAN 1807 - 13 MAY 1809) (21, respectful act however up to 25)
// https://it.wikisource.org/wiki/Codice_di_Napoleone_il_grande/Libro_I/Titolo_V


// ============================================================
// Source
// ============================================================

// primary record
// A source from which genealogical information is derived. A source may represent a document, publication, archive record, inscription, oral
// testimony, database entry, image, audio recording, or any other evidence-bearing artifact.
// Citation relationships SHOULD NOT form cycles.
record SourceRecord {
  title+: NameStructure             // the title of the work, record, or item and, when appropriate, the title of the larger work or series of which it is a part
  author*: Agent                    // the persons, groups, or entities who created the record (author, compiler, transcriber, notary, clerk, ...). For a published work, this could be the author, compiler, transcriber, abstractor, or editor. For an unpublished source, this may be an individual, a government agency, church organization, or private organization, etc.
  publisher?: Text                  // name of the publisher of the publication
  date?: DateStructure              // the date this source was created
  place?: PlaceCitation             // the place this source was created
  media_type?: enum {
    audio, book, card, electronic, fiche, film, magazine, manuscript, map, newspaper, photo, tombstone, video
  } | Text
  repository*: RepositoryCitation
  document*: Xref<DocumentRecord>   // a document reference to the auxiliary data to be linked to this context
  note*: NoteStructure              // may contain information to identify a book (ISBN code, ...), a digital archive (website name, creator, ...), a microfilm (record title, record file, collection, film UUID, roll number, ...), etc.
  privacy?: PrivacyStructure
  audit: AuditStructure
}

// An agent that created, holds, or acted upon something: a record of this file, or a free-text description when it is not described in the file.
Agent = oneof {
  individual: Xref<IndividualRecord>   // an individual described in this file
  group: Xref<GroupRecord>             // a group or organization described in this file (e.g. a parish, a confraternity)
  text: Text                           // an agent not described in this file (e.g. a publisher's editor, an unidentified clerk)
}

// embedded
// Reference to a SOURCE record used as evidence for an assertion, together with optional location, extracts, and evidence classification.
// A SourceCitation is one piece of evidence for the assertion that contains it.
struct SourceCitation {
  source: Xref<SourceRecord>
  locator?: Text   // specific location within the source referenced, in the form of a label and value pair (e.g., 'Line: 28', or 'Page: 143, Entry: 17', or 'folio', etc.)
  extract*: ExtractStructure
  evidence?: EvidenceQualifiers   // classification of this source's contribution to the assertion it is cited for
  privacy?: PrivacyStructure

  require extract.document_part.document in source.document
}

// embedded
struct ExtractStructure {
  document_part*: struct {
    document: Xref<DocumentRecord>
    page?: Int          // 1-based page, for multi-page documents (e.g. PDF, TIFF); CROP refers to this page TODO
    crop?: CropRect     // region of the image or page, in pixels
    start?: Duration    // for audio and video: start of the cited segment, from the beginning of the media TODO
    end?: Duration      // for audio and video: end of the cited segment TODO
  }
  text?: Text
  type?: enum {   // Describes how the TEXT value relates to the content of the cited source.
    verbatim,     // The text is reproduced exactly as it appears in the source, preserving the original wording, spelling, abbreviations, capitalization, and punctuation. No editorial changes have been made.
    summarized,   // The text is a researcher-created summary of the relevant source content. It conveys the meaning of the source without reproducing the wording exactly and may omit details considered irrelevant to the citation.
    translated,   // The text is a translation of source content into another language. The meaning should be preserved, but the wording differs from the source because of the language conversion.
    normalized    // The text has been regularized for readability or analysis while remaining in the same language. Examples include expanding abbreviations, modernizing spelling, standardizing capitalization, converting archaic letter forms, or regularizing date and name formats.
  }
  locale?: LocaleCode
  remark*: Text   // short free-text remark about this extract

  require at_least_one(document_part, text)
}

// Cropping rectangle expressed in image pixels, relative to the WIDTH and HEIGHT declared by the DOCUMENT.
// When the image no longer matches those dimensions, consumers SHOULD rescale crops if the aspect ratio is unchanged, and warn otherwise.
struct CropRect {
  x: Int
  y: Int
  width: Int
  height: Int

  require width > 0
  require height > 0
}


// ============================================================
// Document
// ============================================================

// primary record
// A digital or physical representation associated with a source, such as an image, PDF, scan, transcription, audio recording, video, or other media
// resource.
record DocumentRecord {
  uri: Uri             // URI identifying the underlying resource.
  width?: Int          // for images and paged documents: width in pixels of the image, or of each page; CropRects referring to this document are expressed in this pixel space
  height?: Int         // for images and paged documents: height in pixels of the image, or of each page
  mapping?: enum {     // Describes how visual image data should be interpreted and rendered.
    planar,                                   // Standard two-dimensional image with no panoramic or 3D projection.
    spherical_equirectangular,                // Full spherical panorama stored using an equirectangular projection, typically with a 2:1 aspect ratio and intended for 360° viewing.
    spherical_uv,                             // Image mapped directly onto a sphere using UV texture coordinates.
    cubemap,                                  // Image represented as six cube faces forming a complete panoramic view.
    cylindrical_equirectangular_horizontal,   // Cylindrical panorama wrapped horizontally around a cylinder.
    cylindrical_equirectangular_vertical      // Cylindrical panorama wrapped vertically around a cylinder.
  } | Text
  description?: Text   // Optional description of the document or media (e.g. "cover", "back", "page 3", "index", "cemetery entrance").
  note*: NoteStructure
  privacy?: PrivacyStructure
  audit: AuditStructure
}


// ============================================================
// Date
// ============================================================

// embedded
// Used for historical, documentary, and genealogical dates whose value may require interpretation, source evaluation, calendar conversion, or
// evidentiary analysis. Administrative dates such as creation dates, update dates, search dates, expiration dates, and other system metadata should
// use the simpler `DateTime` type instead.
struct DateStructure {
  value: DateValue          // contains the normalized date assertion according to the conventions of this protocol. The normalized value MAY be derived from a source expression, calendar conversion, date normalization, abbreviation expansion, calculation, or researcher interpretation.
  original_text?: Text      // preserves the date expression exactly as found in the source, when available
  source*: SourceCitation   // the evidence that this date was true
  confidence?: Confidence   // confidence that this date was true
}

// embedded
// Represents the nature of a date assertion. A date can be a single point, an uncertainty interval, or a duration spanning an actual period of time.
DateValue = oneof {
  point: SingleDate        // a single point in time. Unless marked as APPROXIMATE, the value is accepted as recorded, derived, or concluded from the available evidence.
  bounded: BoundedDate     // the exact date is unknown but is known to fall within the specified interval. The interval represents uncertainty about the date itself, not the duration of the fact.
  spanning: SpanningDate   // the fact itself extends across the specified interval. Unlike BoundedDate, the interval does not represent uncertainty about a date; it represents the actual duration of the event, status, relationship, or condition.
}

// embedded
struct BoundedDate {
  not_before?: SingleDate
  not_after?: SingleDate

  require one_of(not_before, not_after)   // At least one of NOT_BEFORE or NOT_AFTER is required. An omitted bound represents an open-ended limit. When both bounds are present, NOT_BEFORE MUST be <= NOT_AFTER.
}

// embedded
struct SpanningDate {
  from?: SingleDate
  to?: SingleDate

  require one_of(from, to)   // At least one of FROM or TO is required. An omitted bound represents an open-ended limit. When both bounds are present, FROM MUST be <= TO.
}

// embedded
// Indicates that the asserted date should be treated as approximate.
// APPROXIMATE qualifies the confidence of the date but does not change the underlying normalized value.
struct Approximate {
  basis?: enum {
    stated,         // the source itself says "about"/"around"
    calculated,     // arithmetically derived from another known date, e.g., age at death
    conventional,   // deduced by applying a cultural norm typical of the period/place
    unspecified
  }
  cultural_norm*: Xref<CulturalNormRecord>   // the cultural norms that justify the estimate; required when BASIS is conventional, forbidden otherwise
  margin?: Duration                          // plus/minus margin, expressed in the units (years, months, days) of the CALENDAR of the enclosing date (e.g. 'P2Y' = plus/minus 2 years)
}

// embedded
// A single point in time expressed at an explicitly declared level of precision. The granularity is determined by the selected representation
// and is not inferred from formatting conventions.
struct SingleDate {
  value: SingleDateValue
  calendar: CalendarType | Text
  approximate?: Approximate     // Qualifies the precision of this date. The underlying date remains the asserted value; APPROXIMATE describes uncertainty about that value.
}

// embedded
SingleDateValue = oneof {
  full_date: HistoricalDate   // a historical date, in the notation of CALENDAR
  decade: Int                 // a decade identified by its starting year. For example, 1490 represents the decade commonly referred to as the '1490s'
  century: struct {
    ordinal: Int              // a century designation, such as 15 for the 15th century
    part?: CenturyPart        // an optional subdivision of the century
  }
}

// embedded
enum CalendarType {
  gregorian, julian, reformed_julian, islamic, hebrew, chinese, indian, buddhist, french_republican, coptic, soviet_eternal, ethiopian, mayan, persian, parsi, byzantine, egyptian, seleucid, armenian, rumi
}

// embedded
// A subdivision of the century, such as a quarter, half, or relative position.
enum CenturyPart {
  first_quarter, second_quarter, third_quarter, fourth_quarter,
  first_half, second_half, early, mid, late
}


// ============================================================
// Historic event
// ============================================================

// primary record
// Historic events provide contextual information. They SHOULD NOT be interpreted as evidence that a specific individual,
// group, or place participated in the event unless additional records establish such a connection.
// A significant historical event that may provide context for genealogical research. Historic events can explain migrations, mortality patterns,
// social changes, legal reforms, economic conditions, territorial changes, epidemics, wars, natural disasters, or scientific discoveries that
// affected individuals, families, groups, or places. Unlike EVENT records, a HISTORIC_EVENT is not normally tied to a specific individual or group. It
// exists primarily to provide historical, legal, social, environmental, or political context.
record HistoricEventRecord {
  type?: enum {
    war,                    // Armed conflict between states, governments, factions, or organized groups.
    epidemic,               // Widespread outbreak of an infectious disease affecting a population within a region.
    famine,                 // Severe shortage of food resulting in widespread hunger, malnutrition, or mortality.
    migration,              // Large-scale movement or resettlement of populations across regions or political boundaries.
    legal_reform,           // Introduction, modification, or abolition of laws, legal systems, or judicial frameworks.
    political_change,       // Significant alteration of political authority, governance, sovereignty, or regime structure.
    territorial_change,     // Modification of borders, jurisdictions, territorial ownership, or administrative organization.
    natural_disaster,       // Destructive natural event such as an earthquake, flood, volcanic eruption, wildfire, drought, or storm.
    economic_crisis,        // Major disruption of economic activity, including depressions, financial crashes, inflation crises, or trade collapses.
    scientific_discovery,   // Scientific breakthrough, technological innovation, or major advancement affecting society or historical development.
    religious_reform,       // Major religious, ecclesiastical, or doctrinal change affecting institutions or populations.
    social_movement,        // Organized social or cultural movement that influences societal norms, rights, or collective behavior.
    pandemic                // Epidemic affecting multiple countries or continents.
  } | Text
  title?: Text              // the title of the event
  date?: DateStructure      // the date on which this historic event happened
  place?: PlaceCitation     // the place in which this historic event happened
  note*: NoteStructure
  source*: SourceCitation   // the evidence that this historic event was true
  confidence?: Confidence   // confidence that this historic event was true
  audit: AuditStructure
}


// ============================================================
// Research
// ============================================================

// primary record
// Represents a research objective, question, hypothesis, or problem that requires investigation. Multiple research activities may contribute to
// answering the same question.
//
// ResearchQuestionRecord.conclusion provides a convenient summary of the current answer to a research question.
// ConclusionRecord represents a formal analytical decision that evaluates one or more competing assertions, hypotheses, or records.
// A research question MAY have a summary conclusion without any ConclusionRecord.
// Conversely, one or more ConclusionRecord instances MAY contribute to the conclusion of a research question.
record ResearchQuestionRecord {
  title: Text               // short human-readable summary of the research objective
  question: Text            // the actual research question or hypothesis being investigated
  target*: ResearchTarget   // people, families, events, places, or records involved in the question; empty when no target has been identified yet
  status: enum {
    open,       // investigation is ongoing
    on_hold,    // temporarily suspended
    resolved,   // sufficient evidence has been gathered
    abandoned   // investigation is abandoned
  }
  conclusion?: Text         // Current answer or working conclusion for this research question. This field is intended as a concise human-readable summary of the researcher's current assessment. Unlike ConclusionRecord, this field does not formally resolve conflicting evidence and does not provide structured proof analysis. It serves as an executive summary of the present state of research.
  conclusion_confidence?: Confidence   // The researcher's confidence in the current conclusion. It is intended for planning, prioritization, reporting, and user interfaces, and does not replace formal proof evaluation expressed through ConclusionRecord.
  rationale?: Text          // explanation supporting the conclusion
  closed_date?: DateTime    // date the question was resolved or abandoned
  privacy?: PrivacyStructure
  audit: AuditStructure
}

ResearchTarget = oneof {
  individual: Xref<IndividualRecord>
  group: Xref<GroupRecord>
  event: Xref<EventRecord>
  event_participation: Xref<EventParticipationRecord>
  relationship: Xref<RelationshipRecord>
  individual_attribute: Xref<IndividualAttributeRecord>
  group_attribute: Xref<GroupAttributeRecord>
  place: Xref<PlaceRecord>
  place_relationship: Xref<PlaceRelationshipRecord>
  repository: Xref<RepositoryRecord>	// TODO new
  source: Xref<SourceRecord>
  document: Xref<DocumentRecord>
  conclusion: Xref<ConclusionRecord>	// TODO new
  identity_hypothesis: Xref<IdentityHypothesisRecord>
  cultural_norm: Xref<CulturalNormRecord>
  historic_event: Xref<HistoricEventRecord>
}

// primary record
// Documents a single research action (performed or planned).
// Activities represent the work of the researcher rather than genealogical facts themselves.
record ResearchActivityRecord {
  question*: Xref<ResearchQuestionRecord>          // research questions to which this activity contributes
  activity_type: enum {
    search,           // searched a repository, index, catalog, or collection
    review,           // examined a specific source or record
    analysis,         // analyzed evidence or correlations
    correspondence,   // exchanged messages with archives, institutions, or individuals
    interview,        // interviewed a person
    hypothesis        // formulated or refined a research hypothesis
  }
  status: enum {
    planned,
    in_progress,
    completed,
    abandoned
  }
  action: Text                                     // description of the work performed
  //date?: DateTime                                  // when the activity was performed (or, for a PLANNED activity, when it is scheduled); not the date the record was written, which is in AUDIT

  target?: ResearchTarget                          // person, family, event, place, or record being investigated
  search_scope?: struct {                          // primarily applicable to search and review activities
    type: enum {
      entire_source,     // complete source reviewed
      index_only,        // only the index was examined
      partial_source,    // a limited portion of the source was examined
      selected_entries   // specific entries were reviewed
    }
    detail?: Text   // details about pages, years, volumes, entries, etc.
  }

  result?: enum {
    positive,       // relevant information was found
    negative,       // search completed with no relevant findings
    inconclusive,   // findings exist but do not answer the question
    conflicting,    // findings conflict with other evidence
    unavailable     // source was inaccessible, unreadable, lost, etc.
  }
  observation?: Text                               // objective notes describing what was observed
  conclusion?: Text                                // interpretation or conclusion drawn from the observations
  conclusion_confidence?: Confidence               // confidence in the interpretation produced by this activity

  source*: SourceCitation                          // sources consulted, examined, or discovered
  parent_activity?: Xref<ResearchActivityRecord>   // previous activity from which this activity originated
  follow_up*: Xref<ResearchTaskRecord>             // tasks that should start when this activity is completed; independent of the tasks' CREATED_BY
  privacy?: PrivacyStructure
  audit: AuditStructure
}

// primary record
// Represents a planned or actionable follow-up item resulting from one or more research activities or research questions.
record ResearchTaskRecord {
  description: Text                           // work that should be performed
  question*: Xref<ResearchQuestionRecord>     // research questions supported by this task
  created_by?: Xref<ResearchActivityRecord>   // activity that generated the task
  status: enum {
   open,          // not yet started
   in_progress,   // currently being worked on
   completed,     // successfully completed
   abandoned      // intentionally discontinued
  }
  priority?: enum { low, normal, high }
  due_date?: DateTime                         // optional target completion date
  outcome?: Text                              // notes describing the result once completed
  privacy?: PrivacyStructure
  audit: AuditStructure
}

// primary record
// A formal statement that resolves a conflict between conflicting evidence by selecting the hypothesis deemed most truthful based on a critical
// analysis of the sources.
// Conclusions are research outcomes rather than source assertions. A conclusion records the researcher’s evaluation of competing
// evidence and is separate from the underlying records it analyzes.
// A conclusion does not modify, invalidate, or delete the records it evaluates (the only exception is Merge, see the global rules). All competing
// assertions remain preserved so that the reasoning process remains transparent and auditable.
// Conclusions never replace evidence. The protocol preserves source assertions, competing hypotheses, and researcher conclusions simultaneously.
record ConclusionRecord {
  issue: Text                               // the specific issue that is resolved, e.g. an event type, "birth_date", "marriage_place", "parentage", "death_cause", "relationship_type"
  proof_status: enum {
    conflicting_evidence,   // the evidence is conflicting, none prevails
    supported,              // preponderance of evidence, but not absolute certainty
    proven,                 // proven according to the Genealogical Proof Standard
    disproven               // proven false
  }
  narrative?: Text                          // a discursive text that explains the logical reasoning, the sources evaluated and the reason why this conclusion was chosen
  resolves*: ConclusionTarget               // a pointer to one or more conflicting assertions or hypotheses. When PROOF_STATUS is DISPROVEN, RESOLVES SHOULD normally contain at least two targets.
  preferred?: ConclusionTarget              // the assertion or hypothesis judged most likely to be correct. If the conclusion is purely negative (e.g., "none of the hypotheses are valid"), this field can be omitted. When present, PREFERRED MUST be one of the records listed in RESOLVES. When PROOF_STATUS is DISPROVEN, PREFERRED SHOULD normally be omitted.
  research*: Xref<ResearchQuestionRecord>   // references to research questions that led to this conclusion
  source*: SourceCitation                   // any sources that support the conclusion itself (e.g., a methodology treatise, or a secondary source that has already resolved the conflict)
  privacy?: PrivacyStructure
  audit: AuditStructure

  require preferred member_of resolves
}

ConclusionTarget = oneof {
  event: Xref<EventRecord>
  event_participation: Xref<EventParticipationRecord>
  relationship: Xref<RelationshipRecord>
  individual: Xref<IndividualRecord>
  individual_attribute: Xref<IndividualAttributeRecord>
  group: Xref<GroupRecord>
  group_attribute: Xref<GroupAttributeRecord>
  identity_hypothesis: Xref<IdentityHypothesisRecord>
  place: Xref<PlaceRecord>
  place_relationship: Xref<PlaceRelationshipRecord>
  repository: Xref<RepositoryRecord>	// TODO new
  source: Xref<SourceRecord>
  document: Xref<DocumentRecord>			// TODO new
  cultural_norm: Xref<CulturalNormRecord>
  historic_event: Xref<HistoricEventRecord>
}


// ================================================
// Privacy, audit, identity, evidence
// ================================================

// embedded
// Specifies how this structure may be displayed, exported, or distributed. The privacy expresses the intent of the data contributor and should be
// respected regardless of any automatic privacy policy applied by the receiving system.
struct PrivacyStructure {
  level: enum {
    public,        // information may be freely displayed, exported, and distributed
    restricted,    // information should be treated with caution and may be omitted from public reports, exports, or distributions
    confidential   // information should not normally be displayed, exported, or included in public distributions
  }
  reason?: enum {   // Standardized reason for the restriction. Custom values MAY be supplied for application-specific needs. REASON SHOULD be omitted when LEVEL is public.
    living_person, privacy_law, copyright, repository_license, sensitive_information
  } | Text
  expires?: DateTime   // the date this restriction expires
}

// embedded
// Audit trail describing when the structure was created and subsequently modified. This information concerns the record itself, not the historical
// subject represented by the record.
struct AuditStructure {
  creation: struct {
    date: DateTime   // the date of the creation of this structure
    comment?: Text
  }
  update*: struct {
    date: DateTime   // the date of the changing of this structure
    comment?: Text   // SHOULD state, after a merge, the ID of the absorbed record and the evidence that justified it; after replacing a conclusion, the replaced reasoning
  }
}

// association record
// Represents the possibility that two records describe the same real-world entity and are therefore candidates for a merge.
// The hypothesis itself carries no acceptance or rejection status: it can be evaluated through ConclusionRecord instances, and it is accepted by
// performing the merge (see Merge in the global rules), after which it is deleted.
// IDENTITY[0] and IDENTITY[1] MUST reference different records of the same kind.
// The presence of an identity hypothesis does not imply that the entities are likely to be identical; CONFIDENCE expresses the researcher's
// current estimate.
// Multiple conclusions MAY evaluate the same identity hypothesis over time.
record IdentityHypothesisRecord {
  identity+: IdentityCandidate
  rationale?: Text          // the basis for the possible identity (e.g. same parents and parish in both records)
  source*: SourceCitation   // the evidence that this hypothesis is true
  confidence?: Confidence   // confidence that this hypothesis is true
  audit: AuditStructure

  require count(identity) == 2
  require identity[0] != identity[1]
  require type(identity[0]) == type(identity[1])
}

IdentityCandidate = oneof {
  individual: Xref<IndividualRecord>
  group: Xref<GroupRecord>
  place: Xref<PlaceRecord>
  source: Xref<SourceRecord>
  repository: Xref<RepositoryRecord>
  document: Xref<DocumentRecord>
  cultural_norm: Xref<CulturalNormRecord>
  historic_event: Xref<HistoricEventRecord>
}

// embedded
// Classification of one source's contribution to one assertion.
// These qualifiers apply to the source as cited for that specific assertion and do not express the reliability, authority, or quality of the source as a whole.
struct EvidenceQualifiers {
  source_type?: enum {        // Classification of the source item
    original,   // first recording
    derived     // copy, transcription, abstract, index, ...
  }
  information_type?: enum {   // Classification of the information provided by the source
    primary,       // informant with first-hand knowledge
    secondary,     // informant with second-hand knowledge
    undetermined
  }
  evidence_type?: enum {      // Relation between the information and the assertion
    direct,     // states it
    indirect,   // implies it
    negative    // inferred from absence
  }
}

// The researcher's confidence that an assertion is true, based on the citations supporting it.
enum Confidence {
  low,      // limited evidence, unresolved conflicts, or speculative
  medium,   // evidence generally supports the assertion, but gaps or uncertainties remain
  high      // evidence strongly supports the assertion and no significant unresolved conflicts are known
}
